    OFIARY\",\"parentUIDs\":[0],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":92}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":398,\"yPos\":963},\"ID\":87,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"PERGAMIN\",\"parentUIDs\":[85],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":93}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":1020,\"yPos\":965},\"ID\":88,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"PIER\u015ACIE\u0143\",\"parentUIDs\":[85],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":91}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":324,\"yPos\":525},\"ID\":90,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"POSTRZA\u0141\",\"parentUIDs\":[89],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":0}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-9,\"yPos\":424},\"ID\":94,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Dalej\",\"parentUIDs\":[76],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":0}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":424,\"yPos\":706},\"ID\":95,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Dalej\",\"parentUIDs\":[91],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":85}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":669,\"yPos\":1177},\"ID\":97,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Dalej\",\"parentUIDs\":[92],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":85}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":881,\"yPos\":1177},\"ID\":99,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Dalej\",\"parentUIDs\":[93],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":0}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":1119,\"yPos\":533},\"ID\":100,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Wr\xF3\u0107\",\"parentUIDs\":[85],\"SpeechUID\":-1}],\"Parameters\":[],\"SpeechNodes\":[{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":48},{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":73},{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":64},{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":54}],\"EditorInfo\":{\"isRoot\":true,\"xPos\":690,\"yPos\":119},\"ID\":0,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Co
    my tu mamy...\",\"parentUIDs\":[100,94,95],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Watson\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0.1,\"Volume\":0},{\"Connections\":[],\"EditorInfo\":{\"isRoot\":false,\"xPos\":1498,\"yPos\":378},\"ID\":55,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Na
    razie, to wszystko.\",\"parentUIDs\":[54],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Watson\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":94},{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":54}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-8,\"yPos\":303},\"ID\":76,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Nasza
    ofiara zosta\u0142a postrzelona w g\u0142ow\u0119, nie widz\u0119 dziury wylotowej,
    co oznacza, \u017Ce kula utkwi\u0142a w czaszce.  Stzrelec musia\u0142 mie\u0107
    albo bardzo s\u0142ab\u0105 bro\u0144, albo sta\u0107 naprawd\u0119 daleko.\",\"parentUIDs\":[48],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Watson\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":87},{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":88},{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":100}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":767,\"yPos\":944},\"ID\":85,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"No
    prosz\u0119...\",\"parentUIDs\":[64,97,99],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Watson\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":90}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":327,\"yPos\":431},\"ID\":89,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Na
    ofierze ani w jej pobli\u017Cu nie ma \u017Cadnych podejrzanych \u015Blad\xF3w,
    w tym prochu. Strza\u0142 nie pad\u0142 raczej przy stole\",\"parentUIDs\":[73],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Watson\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":95},{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":54}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":321,\"yPos\":588},\"ID\":91,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Strza\u0142
    prosto w g\u0142ow\u0119 \u015Bwiadczy o do\u015Bwiadczeniu strzelca. By\u0142o
    ciemno wi\u0119c musia\u0142 dok\u0142adnie wiedzie\u0107 gdzie Lady Ogilvy siedzia\u0142a.
    Niestety, odrzut sprawi\u0142, \u017Ce ofiara zmieni\u0142a pozycj\u0119, wi\u0119c
    nie wiem sk\u0105d pad\u0142 strza\u0142. Warto zbada\u0107 pomieszczenie.\",\"parentUIDs\":[90],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Watson\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":97},{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":54}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":479,\"yPos\":1039},\"ID\":92,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Pergamin,
    mo\u017Ce to mia\u0142 by\u0107 jaki\u015B list?  Ale de facto pusty...\",\"parentUIDs\":[87],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Watson\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":99},{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":54}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":1099,\"yPos\":1061},\"ID\":93,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"\\\"Ofiara
    ma na kciuku pier\u015Bcie\u0144, to dziwne...Wygl\u0105da na to, \u017Ce jest
    za du\u017Cy, zapewne nie nale\u017Ca\u0142 do niej. Jest na nim wygrawerowana
    litera A.\\n(Je\u015Bli najpier porozmawiali\u015Bmy z Violet o Relacjach Lady
    Ogilvy)\\n...ale Lady Edith by\u0142a niezam\u0119zna, wi\u0119c sk\u0105t ten
    symbol?\\\"\",\"parentUIDs\":[88],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Watson\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0}]}"
