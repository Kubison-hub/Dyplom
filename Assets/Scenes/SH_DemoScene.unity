  CurrentIDCounter: 2
  json: "{\"Options\":[],\"Parameters\":[],\"SpeechNodes\":[{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":1}],\"EditorInfo\":{\"isRoot\":true,\"xPos\":247.800018,\"yPos\":297.199982},\"ID\":0,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"My\u015Bl\u0119,
    \u017Ce potrzeba Violet porozmawiania z Cioci\u0105 mo\u017Ce nam si\u0119 przyda\u0107,
    by odci\u0105gn\u0105\u0107 Madame Selm\u0119 od schod\xF3w. Mysl\u0119, \u017Ce
    jej celem nie jest ochrona c\xF3rki, a ukrycie swoich sekret\xF3w na pi\u0119trze.\",\"parentUIDs\":[],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Watson\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[],\"EditorInfo\":{\"isRoot\":false,\"xPos\":249.800018,\"yPos\":438.2},\"ID\":1,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Dok\u0142adnie
    Watsonie, musimy zrobi\u0107 co\u015B aby Violet uwierzy\u0142a, \u017Ce jej
    duch Lady Ogilvy tu jest. Tak oci\u0105gniemy nasze Medium.\",\"parentUIDs\":[0],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Sherlock\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0}]}"
