  json: "{\"Options\":[{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":76}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":92,\"yPos\":264},\"ID\":48,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"LADY
