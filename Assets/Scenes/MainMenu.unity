    - target: {fileID: 1460160271564723240, guid: bfd884273cd9d8948ac82cc111a9c06f, type: 3}
      propertyPath: m_text
      value: "<b>Maja Bartnicka</b>\r\nProducent \xB7 Projektant poziom\xF3w \xB7
