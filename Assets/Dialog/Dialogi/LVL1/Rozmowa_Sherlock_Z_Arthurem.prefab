  json: "{\"Options\":[{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":50}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-167.6665,\"yPos\":292.000183},\"ID\":48,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Jak
    d\u0142ugo by\u0142 Pan ochroniarzem Lady Edith?\",\"parentUIDs\":[59],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":55}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":659.333557,\"yPos\":265.3334},\"ID\":54,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Do
    widzenia...\",\"parentUIDs\":[58,59,61,70],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":68}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":263.333557,\"yPos\":494.666565},\"ID\":66,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Czy
    ochroniarze powinni wymienia\u0107 si\u0119 informacjami?\",\"parentUIDs\":[63],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":59}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":107.666321,\"yPos\":893.6672},\"ID\":71,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Ale\u017C
    oczywi\u015Bcie... Zmie\u0144my temat.\",\"parentUIDs\":[70],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":59}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-86.9999542,\"yPos\":698.6667},\"ID\":72,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"To
    w takim razie wr\xF3\u0107my reszty do pyta\u0144.\",\"parentUIDs\":[61],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":58}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-533.333069,\"yPos\":255.333374},\"ID\":73,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Kim
    Pan jest?\",\"parentUIDs\":[75],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":59}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-536.666565,\"yPos\":451.3333},\"ID\":74,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Mhm...\",\"parentUIDs\":[58],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":63}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":263.333557,\"yPos\":260.333282},\"ID\":76,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"A
    co s\u0105dzi Pan o zebranych? Zna Pan tu kogo\u015B jeszcze?\",\"parentUIDs\":[59],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":70}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":267.3338,\"yPos\":687.6668},\"ID\":77,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Mo\u017Ce
    to Duchowny co\u015B Panu zdradza\u0142?\",\"parentUIDs\":[68],\"SpeechUID\":-1}],\"Parameters\":[],\"SpeechNodes\":[{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":75}],\"EditorInfo\":{\"isRoot\":true,\"xPos\":153.666687,\"yPos\":-242.666656},\"ID\":0,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Witam
    Panowie.\",\"parentUIDs\":[],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"...\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0.1,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":60}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-238.6665,\"yPos\":399.666443},\"ID\":50,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Od
    kilku lat, towarzyszy\u0142em jej praktycznie wsz\u0119dzie, ufa\u0142a mi...\",\"parentUIDs\":[48],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Arthur\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[],\"EditorInfo\":{\"isRoot\":false,\"xPos\":660.6668,\"yPos\":397.3333},\"ID\":55,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Zapewne
    do Pana jeszcze wr\xF3cimy...\",\"parentUIDs\":[54],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Sherlock\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":74},{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":54}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-537.9998,\"yPos\":337.000183},\"ID\":58,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Nazywam
    si\u0119 Artur i jestem...By\u0142em ochroniarzem Lady Edith.\",\"parentUIDs\":[73],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Arthur\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":48},{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":76},{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":54}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":156.333313,\"yPos\":-34.6666565},\"ID\":59,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"W
    czym mog\u0119 pom\xF3c?\",\"parentUIDs\":[71,72,74],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Arthur\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":61}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-236.6665,\"yPos\":491.666443},\"ID\":60,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Czy
    by\u0142a to tylko zawodowa relacja? Wida\u0107, \u017Ce zale\u017Ca\u0142o Panu.\",\"parentUIDs\":[50],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Sherlock\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":72},{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":54}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-235.6665,\"yPos\":583.000061},\"ID\":61,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Nie,
    nie\u2026 To wy\u0142\u0105cznie obowi\u0105zek, nic wi\u0119cej.\",\"parentUIDs\":[60],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Arthur\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":66}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":257.333557,\"yPos\":383.3333},\"ID\":63,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Lady
    Violet z narzeczonym widuj\u0119 cz\u0119sto, to mi\u0142a para. Rozmawiam te\u017C
    z Georem, ochroniarzem m\u0142odszej Panny Ogilvy. Madame Selm\u0119 widuj\u0119,
    chocia\u017Cby na seansach Lady Edith czy na dworze kr\xF3lowej Wiktorii. \",\"parentUIDs\":[76],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Arthur\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":77}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":264.6668,\"yPos\":576.3333},\"ID\":68,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Sekret\xF3w
    nie zdradzam nikomu. Przez cz\u0119ste spotkania obydwu pa\u0144 po prostu cz\u0119sto
    si\u0119 widujemy. Chyba wsp\xF3lne rozmowy to nie przest\u0119pstwo?\",\"parentUIDs\":[66],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Arthur\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":71},{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":54}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":265.667053,\"yPos\":777.0007},\"ID\":70,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Przepraszam
    bardzo, ale o tym co chcia\u0142by powiedzie\u0107 Duchowny George powinien wypowiada\u0107
    si\u0119 on sam.\",\"parentUIDs\":[77],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Arthur\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":73}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":154.666687,\"yPos\":-138.000031},\"ID\":75,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"W
    czym mog\u0119 pom\xF3c?\",\"parentUIDs\":[0],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"...\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0}]}"
