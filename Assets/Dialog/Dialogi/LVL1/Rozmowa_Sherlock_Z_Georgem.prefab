  CurrentIDCounter: 117
  json: "{\"Options\":[{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":77}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-255.666687,\"yPos\":400},\"ID\":48,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Co
    s\u0105dzi Ojciec o Lady Edith?\",\"parentUIDs\":[75],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":55}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":805.6667,\"yPos\":395.3333},\"ID\":54,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Dzi\u0119kuj\u0119...
    Ojcze.\",\"parentUIDs\":[75,85,89,91,103],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":91}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":282.000244,\"yPos\":402},\"ID\":64,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Dlaczego
    nie wszed\u0142 Ojciec do \u015Brodka?\",\"parentUIDs\":[75],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":87}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":8.333801,\"yPos\":400.6667},\"ID\":73,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Jest
    Ojciec oficjalnym opiekunem Lady Violet?\",\"parentUIDs\":[75],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":75}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-297.666443,\"yPos\":1212.99963},\"ID\":92,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Ale\u017C
    oczywi\u015Bcie... Chc\u0119 jeszcze o co\u015B zapyta\u0107.\",\"parentUIDs\":[85],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":75}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":22.33368,\"yPos\":815.333252},\"ID\":93,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Wszystko
    jasne, kontynuujmy.\",\"parentUIDs\":[89],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":75}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":262.3335,\"yPos\":749.6669},\"ID\":95,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Zrozumia\u0142e
    mo\u017Cemy dalej?\",\"parentUIDs\":[91],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":99}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":511.6679,\"yPos\":397},\"ID\":97,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Wsp\xF3\u0142pracujecie
    z Arthurem?\",\"parentUIDs\":[75],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":75}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":539.334167,\"yPos\":955.333},\"ID\":104,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Te
    infomacje s\u0105 przydatne, kontynuujmy.\",\"parentUIDs\":[103],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":79}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-250.9997,\"yPos\":675},\"ID\":107,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Sk\u0105d
    Ojciec zna\u0142 jej sytuacj\u0119 rodzinn\u0105?\",\"parentUIDs\":[110],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":81}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-484.999756,\"yPos\":696.3334},\"ID\":108,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Czemu
    zmar\u0142a nie powinna by\u0142a szuka\u0107 odpowiedzi?\",\"parentUIDs\":[79,110],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":83}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-488.333,\"yPos\":844.3334},\"ID\":109,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Wida\u0107,
    \u017Ce Ojciec du\u017Co wie...\",\"parentUIDs\":[81],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":110}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-698.3333,\"yPos\":846.333252},\"ID\":112,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Jeszcze
    jedno.\",\"parentUIDs\":[81],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":85}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-487.66626,\"yPos\":993.6665},\"ID\":113,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"M\xF3wi
    pan o Lady Edith?\",\"parentUIDs\":[83],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":89}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":7.66717529,\"yPos\":575.6666},\"ID\":114,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Cz\u0119sto
    przebywa\u0142a ze swoj\u0105 Ciotk\u0105, jej te\u017C ojciec pilnowa\u0142?\",\"parentUIDs\":[87],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":101}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":506.333435,\"yPos\":583},\"ID\":115,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Rozmawiali\u015Bcie
    przed Seansem?\",\"parentUIDs\":[99],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":103}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":503.000183,\"yPos\":765},\"ID\":116,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"A
    co s\u0105dzi Ojciec o Arthurze?\",\"parentUIDs\":[101],\"SpeechUID\":-1}],\"Parameters\":[],\"SpeechNodes\":[{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":59}],\"EditorInfo\":{\"isRoot\":true,\"xPos\":353.333374,\"yPos\":22},\"ID\":0,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Panie-\",\"parentUIDs\":[],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Sherlock\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0.1,\"Volume\":0},{\"Connections\":[],\"EditorInfo\":{\"isRoot\":false,\"xPos\":810.3337,\"yPos\":482.3333},\"ID\":55,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Je\u015Bli
    pojawi\u0105 si\u0119 jeszcze jakie\u015B pytania, wr\xF3cimy.\",\"parentUIDs\":[54],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Sherlock\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":75}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":345.666382,\"yPos\":118.000061},\"ID\":59,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Jestem
    Duchownym, ale najlepiej jest si\u0119 zwraca\u0107 do mnie Ojcze George. Nie
    jestem \u017Cadnym Panem, tylko s\u0142ug\u0105 Pana.\",\"parentUIDs\":[0],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"George\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":48},{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":73},{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":64},{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":97},{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":54}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":347.000122,\"yPos\":216.333374},\"ID\":75,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"S\u0142u\u017C\u0119
    odpowiedziami.\",\"parentUIDs\":[59,92,93,95,104],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"George\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":110}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-257.6667,\"yPos\":473.666748},\"ID\":77,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Biedna...
    nie powinna wcale tutaj przychodzi\u0107.\",\"parentUIDs\":[48],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"George\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":108}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-248.666565,\"yPos\":733.3334},\"ID\":79,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Czy
    nie jest oczywistym, \u017Ce od Lady Violet?\",\"parentUIDs\":[107],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"George\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":109},{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":112}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-486.666626,\"yPos\":753},\"ID\":81,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Poniewa\u017C
    mog\u0142oby to nadszarpn\u0105\u0107 dobre imi\u0119 jej rodziny i zapewne nie
    tylko jej. Mia\u0142a kochaj\u0105c\u0105 rodzin\u0119, po co zna\u0107 prawd\u0119
    o grzechu, z kt\xF3rego powsta\u0142a.\",\"parentUIDs\":[108],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"George\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":113}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-486,\"yPos\":896.9995},\"ID\":83,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Prawda
    jest taka, \u017Ce niezam\u0119\u017Cna kobieta powinna p\xF3j\u015B\u0107 do
    klasztoru, a nie grzeszy\u0107.\",\"parentUIDs\":[109],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"George\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":92},{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":54}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-484,\"yPos\":1063.99878},\"ID\":85,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"...a
    o kim innym?\",\"parentUIDs\":[113],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"George\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":114}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":6.667053,\"yPos\":471.666748},\"ID\":87,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Tak,
    z rozkazu kr\xF3lewskiej ochrony czuwam nad jej bezpiecze\u0144stwem.\",\"parentUIDs\":[73],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"George\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":93},{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":54}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-0.6663208,\"yPos\":662.3334},\"ID\":89,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"By\u0142a
    to raczej uwa\u017Cno\u015B\u0107 z konieczno\u015Bci, ale jestem przekonany,
    \u017Ce gdybym by\u0142 w \u015Brodku, to zapobieg\u0142oby tragedii... To wszystko
    przez Madame Selm\u0119 i jej pod\u0142e praktyki.\",\"parentUIDs\":[114],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"George\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":95},{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":54}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":280.333252,\"yPos\":477.66687},\"ID\":91,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Nie
    pochwalam spirytyzmu, to blu\u017Anierstwo wobec Boga. Moja noga przekroczy\u0142a
    pr\xF3g tego domu dopiero gdy us\u0142ysza\u0142em wystrza\u0142. Wiedzia\u0142em,
    \u017Ce nie sko\u0144czy si\u0119 ta wizyta niczym dobrym...ale nie s\u0105dzi\u0142em,
    \u017Ce a\u017C tak z\u0142ym.\",\"parentUIDs\":[64],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"George\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":115}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":509.6679,\"yPos\":470.000061},\"ID\":99,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"W
    sprawach bezpiecze\u0144stwa - owszem. Oboje mamy pod opiek\u0105 Damy i do tego
    spokrewnione.\",\"parentUIDs\":[97],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"George\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":116}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":505.00116,\"yPos\":664.3336},\"ID\":101,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Tak.
    Prosi\u0142em, aby trzyma\u0142 Lady Edith z dala od tej farsy.\",\"parentUIDs\":[115],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"George\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":54},{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":104}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":512.667664,\"yPos\":844},\"ID\":103,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Arthur
    jest dobrym cz\u0142owiekiem, chocia\u017C emocje cz\u0119sto bior\u0105 nad
    nim g\xF3r\u0119. Serce nie zawsze podpowiada dobrze.\",\"parentUIDs\":[116],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"George\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":107},{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":108}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-254.9997,\"yPos\":564.6666},\"ID\":110,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"
    Szuka\u0142a odpowiedzi, kt\xF3rych nie powinna dr\u0105\u017Cy\u0107.\",\"parentUIDs\":[77,112],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"George\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0}]}"
