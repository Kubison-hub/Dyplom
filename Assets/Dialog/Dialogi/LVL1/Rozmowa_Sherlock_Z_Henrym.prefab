  json: "{\"Options\":[{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":70}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-689.3341,\"yPos\":78.33334},\"ID\":48,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Pozwoli
    Pan na kilka pyta\u0144?\",\"parentUIDs\":[62],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":63}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":63.66768,\"yPos\":133.666656},\"ID\":53,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Czy
    co\u015B \u0142\u0105czy\u0142o Pana z Lady Edith?\",\"parentUIDs\":[62],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":55}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":618.6658,\"yPos\":99.33331},\"ID\":54,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Dzi\u0119kuj\u0119
    za wsp\xF3\u0142prac\u0119.\",\"parentUIDs\":[60,63,68,76],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":62}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-551.33374,\"yPos\":791.9995},\"ID\":61,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Dobrze...Zmie\u0144my
    temat.\",\"parentUIDs\":[60],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":68}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-347.333679,\"yPos\":132.333313},\"ID\":64,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Czy
    zauwa\u017Cy\u0142 Pan co\u015B nietypowego w chwili strza\u0142u?\",\"parentUIDs\":[62],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":62}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-35.66667,\"yPos\":416.333252},\"ID\":65,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Wr\xF3\u0107my
    do innych temat\xF3w.\",\"parentUIDs\":[63],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":62}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-352.000458,\"yPos\":344.999969},\"ID\":69,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Wr\xF3\u0107my
    do innych temat\xF3w.\",\"parentUIDs\":[68],\"SpeechUID\":-1},{\"Connections\":[],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-681.334,\"yPos\":355.666626},\"ID\":72,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"By\u0142
    Pan na sesjach wcze\u015Bniej? Kadzid\u0142o to co\u015B normalnego.\",\"parentUIDs\":[49],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":60}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-677.333862,\"yPos\":533.6664},\"ID\":73,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"...Wierzy
    pan w duchy?\",\"parentUIDs\":[58],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":75}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":324.6664,\"yPos\":119.666595},\"ID\":74,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Czy
    widzia\u0142 Pan aby kto\u015B zachowywa\u0142 si\u0119 dziwnie?\",\"parentUIDs\":[62],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":62}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":317.332916,\"yPos\":456.999939},\"ID\":77,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Wr\xF3\u0107my
    do innych temat\xF3w.\",\"parentUIDs\":[76],\"SpeechUID\":-1}],\"Parameters\":[],\"SpeechNodes\":[{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":62}],\"EditorInfo\":{\"isRoot\":true,\"xPos\":127.666718,\"yPos\":-152.666656},\"ID\":0,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Pan
    Holmes?\\nDobrze, \u017Ce tu jeste\u015Bcie, to straszne co to si\u0119 sta\u0142o.
    Do tego moja biedna Violet....\",\"parentUIDs\":[],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Sir
    Henry\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0.1,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":72}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-690.667358,\"yPos\":249.3334},\"ID\":49,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"To
    wszystko wydarzy\u0142o si\u0119 tak szybko. W jednej chwili zgas\u0142y \u015Bwiat\u0142a,
    a nast\u0119pnie st\xF3\u0142 zacz\u0105\u0142 dygota\u0107\u2026 Powietrze zrobi\u0142o
    si\u0119 ci\u0119\u017Ckie od zapachu kadzid\u0142a, pod\u0142oga zacz\u0119\u0142a
    skrzypie\u0107\u2026 naprawd\u0119 poczu\u0142em czyj\u0105\u015B obecno\u015B\u0107.
    A potem ten straszliwy huk.\",\"parentUIDs\":[70],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Sir
    Henry\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[],\"EditorInfo\":{\"isRoot\":false,\"xPos\":617.6658,\"yPos\":274.333221},\"ID\":55,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Je\u015Bli
    b\u0119dziemy mie\u0107 jakie\u015B pytania, wr\xF3cimy do Pana.\",\"parentUIDs\":[54],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Sherlock\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":73}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-678.6671,\"yPos\":428.3333},\"ID\":58,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Tak,
    bywa\u0142em, ale tym razem, ten zapach by\u0142 intensywniejszy, prawie jak
    w ko\u015Bciele. Mo\u017Ce to kwestia negatywnych emocji ducha? A mo\u017Ce wyj\u0105tkowo
    blisko mnie przeszed\u0142?\",\"parentUIDs\":[],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Sir
    Henry\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":54},{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":61}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-681.334,\"yPos\":629.333252},\"ID\":60,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Niezbadane
    jest \u017Cycie po \u015Bmierci, kto wie, czy sam ojciec nie chcia\u0142 zabra\u0107
    c\xF3rki do siebie?\",\"parentUIDs\":[73],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Sir
    Henry\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":48},{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":64},{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":53},{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":74}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":129.666718,\"yPos\":-59.666687},\"ID\":62,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Jak
    mog\u0119 pom\xF3c?\",\"parentUIDs\":[0,61,65,69,77],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Sir
    Henry\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":65},{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":54}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":17.6668243,\"yPos\":243.999847},\"ID\":63,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"To
    Ciotka mojej narzeczonej. By\u0142a dla mnie surowa, ale sprawiedliwa. Szanowa\u0142em
    j\u0105. Wiem, \u017Ce od \u015Bmierci swojego ojca by\u0142a niespokojna i potrzebowa\u0142a
    tego seansu.\",\"parentUIDs\":[53],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Sir
    Henry\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":69},{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":54}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-352.0004,\"yPos\":235.6666},\"ID\":68,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Zaraz
    przed strza\u0142em us\u0142ysza\u0142em d\u017Awi\u0119k przesuwania czego\u015B...mo\u017Ce
    krzes\u0142a mo\u017Ce sto\u0142u? Po tym jak zgas\u0142o \u015Bwiat\u0142o.\",\"parentUIDs\":[64],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Sir
    Henry\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":49}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-691.3341,\"yPos\":144.666626},\"ID\":70,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Oczywi\u015Bcie, 
    sprawa wymaga pilnego wyja\u015Bnienia.\",\"parentUIDs\":[48],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Sir
    Henry\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":76}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":317.332916,\"yPos\":240.6666},\"ID\":75,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Tutaj?
    Nie. Wiem jedynie, \u017Ce opiekun mojej Lady Violet nie chcia\u0142 tu wchodzi\u0107,
    bo jest to duchowny. Nie lubi seans\xF3w i uwa\u017Ca to za obraz\u0119 Boga.\",\"parentUIDs\":[74],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Sir
    Henry\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":77},{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":54}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":317.332916,\"yPos\":347.9999},\"ID\":76,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Ale
    osobi\u015Bcie uwa\u017Cam, \u017Ce nikt z Nas nie chcia\u0142by skrzywdzi\u0107
    Lady Edith. Musia\u0142 to zrobi\u0107 albo jej ojciec t\u0119skni\u0105cy na
    c\xF3rk\u0105, albo kto\u015B obcy.\",\"parentUIDs\":[75],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Sir
    Henry\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0}]}"
