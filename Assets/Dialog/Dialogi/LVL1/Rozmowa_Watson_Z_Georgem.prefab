  json: "{\"Options\":[{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":77}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":476.3334,\"yPos\":358.000122},\"ID\":48,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Nie
    przepada Ojciec raczej za Madame Selm\u0105.\",\"parentUIDs\":[75],\"SpeechUID\":-1},{\"Connections\":[],\"EditorInfo\":{\"isRoot\":false,\"xPos\":471.0002,\"yPos\":757.6669},\"ID\":54,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Dzi\u0119kuj\u0119
    Ojcze, je\u015Bli pojawi\u0105 si\u0119 jeszcze pytania to wr\xF3cimy.\",\"parentUIDs\":[79],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":79}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":471.999969,\"yPos\":559.6669},\"ID\":85,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Ale
    pozwoli\u0142 Ojciec przyj\u015B\u0107 tutaj swojej podopiecznej.\",\"parentUIDs\":[77],\"SpeechUID\":-1}],\"Parameters\":[],\"SpeechNodes\":[{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":59}],\"EditorInfo\":{\"isRoot\":true,\"xPos\":475.3334,\"yPos\":63.333374},\"ID\":0,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Witam
