  json: "{\"Options\":[{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":60}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":10.333313,\"yPos\":170.666931},\"ID\":48,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Pier\u015Bcie\u0144.\",\"parentUIDs\":[0],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":76}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":32.6664734,\"yPos\":535.6667},\"ID\":87,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Wi\u0119c
    sk\u0105d ten Pier\u015Bcie\u0144 do tego z liter\u0105 A?\",\"parentUIDs\":[61],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":0}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":165.33316,\"yPos\":746.3337},\"ID\":88,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Porozmawiajmy
    o czym\u015B innym.\",\"parentUIDs\":[76],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":91}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":437.333374,\"yPos\":173.000061},\"ID\":90,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Pergamin.\",\"parentUIDs\":[0],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":0}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":302,\"yPos\":507.000122},\"ID\":93,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Porozmawiajmy
    o czym\u015B innym.\",\"parentUIDs\":[92],\"SpeechUID\":-1},{\"Connections\":[],\"EditorInfo\":{\"isRoot\":false,\"xPos\":693.3334,\"yPos\":172.333374},\"ID\":94,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Dzi\u0119kuj\u0119.
    Wracam kontynuowa\u0107 dochodzenie.\",\"parentUIDs\":[0,76,92],\"SpeechUID\":-1}],\"Parameters\":[],\"SpeechNodes\":[{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":48},{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":90},{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":94}],\"EditorInfo\":{\"isRoot\":true,\"xPos\":171.000061,\"yPos\":25.3334351},\"ID\":0,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"O
    co chodzi Panie Watson?\",\"parentUIDs\":[88,93],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Arthur\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0.1,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":61}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":13.3333435,\"yPos\":260.667},\"ID\":60,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Panie
    Arthurze, nie chc\u0119 by\u0107 nachalny. Ale Lady Edith mia\u0142a w kieszeni
    pier\u015Bcie\u0144 z liter\u0105 A... s\u0142ysza\u0142em, \u017Ce zale\u017Ca\u0142o
    Panu na niej.\",\"parentUIDs\":[48],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Watson\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":87}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":22.3333435,\"yPos\":394.000366},\"ID\":61,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Sugeruje
    mi pan romans z w\u0142asn\u0105 podopieczn\u0105? Nigdy bym nie dopu\u015Bci\u0142
    do takiego braku profesjonalizmu.\",\"parentUIDs\":[60],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Arthur\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":88},{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":94}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":33.333374,\"yPos\":624.333069},\"ID\":76,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Wiem,
    \u017Ce Lady Edith Otrzyma\u0142a go od ojca na \u0142o\u017Cu \u015Bmierci,
    ale jego imi\u0119 nie zaczyna\u0142o si\u0119 tak\u017Ce od A. My\u015Bl\u0119,
    \u017Ce nale\u017Ca\u0142 do jej prawdziwego ojca.\",\"parentUIDs\":[87],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Arthur\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":92}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":442.000061,\"yPos\":254.000061},\"ID\":91,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Znalaz\u0142em
    przy Lady Edith pergamin, ale pusty. O co mog\u0142o chodzi\u0107?\",\"parentUIDs\":[90],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Watson\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":93},{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":94}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":439.333374,\"yPos\":362.666718},\"ID\":92,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Nie
    mam poj\u0119cia, mo\u017Ce chcia\u0142a co\u015B zanotowa\u0107? Ci\u0119\u017Cko
    powiedzie\u0107.\",\"parentUIDs\":[91],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Arthur\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0}]}"
