  m_EditorClassIdentifier: 
  CurrentIDCounter: 37
  json: "{\"Options\":[{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":25}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":192,\"yPos\":349.666718},\"ID\":32,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Tak
    Ethel,  twoj\u0105 mam\u0105 wszystko jest dobrze.\",\"parentUIDs\":[23],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":27}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":196,\"yPos\":579.666748},\"ID\":33,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Tat\u0105?\",\"parentUIDs\":[25],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":29}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":197.333313,\"yPos\":800.333557},\"ID\":34,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Twojemu
    tacie nic nie jest.\",\"parentUIDs\":[27],\"SpeechUID\":-1},{\"Connections\":[],\"EditorInfo\":{\"isRoot\":false,\"xPos\":192,\"yPos\":1041.00024},\"ID\":35,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Jak\u0105
    skrzyneczk\u0119?\",\"parentUIDs\":[29],\"SpeechUID\":-1},{\"Connections\":[],\"EditorInfo\":{\"isRoot\":false,\"xPos\":194,\"yPos\":1235.00012},\"ID\":36,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Dzi\u0119kuj\u0119
    ci bardzo.\",\"parentUIDs\":[31],\"SpeechUID\":-1}],\"Parameters\":[],\"SpeechNodes\":[{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":22}],\"EditorInfo\":{\"isRoot\":true,\"xPos\":188,\"yPos\":22},\"ID\":0,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"K-kim
    jeste\u015B! Aaa, pomocy!\",\"parentUIDs\":[],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Ethel\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":23}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":191,\"yPos\":126.000092},\"ID\":22,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Spokojnie,
    pami\u0119tasz nas z g\xF3ry? Byli\u015Bmy na seansie.\",\"parentUIDs\":[0],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Watson\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":32}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":192,\"yPos\":238.000092},\"ID\":23,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Czy
    z moj\u0105 mam\u0105 wszystko w porz\u0105dku? Us\u0142ysza\u0142am strza\u0142,
    a chwil\u0119 wcze\u015Bniej min\u0119\u0142am si\u0119 w podziemiach z jakim\u015B
    wielkim Panem. Wystraszy\u0142am si\u0119 i przybieg\u0142am tutaj...\",\"parentUIDs\":[22],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Ethel\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":33}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":196.333374,\"yPos\":461.000122},\"ID\":25,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"A...
    a z tat\u0105? Nie powinnam pyta\u0107 ale boj\u0119 si\u0119...\",\"parentUIDs\":[32],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Ethel\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":34}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":196,\"yPos\":675.0002},\"ID\":27,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Nie
    powinnam tego m\xF3wi\u0107, bo podobno m\xF3j tata to taki dzisiejszy rycerz
    i m\xF3wi\u0142 mi, \u017Ce w musi dzia\u0142a\u0107 w tajemnicy. By\u0142 dzisiaj
    na seansie ze starsz\u0105 Pani\u0105, kt\xF3r\u0105 chroni. Czy wszystko z nim
    dobrze?\",\"parentUIDs\":[33],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Ethel\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":35}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":194,\"yPos\":908.334},\"ID\":29,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Jak
    dobrze... mama m\xF3wi\u0142a, \u017Ce jak b\u0119dzie dzia\u0142o si\u0119 co\u015B
    z\u0142ego to mam schowa\u0107 si\u0119 tutaj, a potem i\u015B\u0107 do Pa\u0142acu,
    je\u015Bli si\u0119 da to z Lady Violet i..i przekaza\u0107 skrzyneczk\u0119
    Kr\xF3lowej.\",\"parentUIDs\":[34],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Ethel\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":36}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":197.333313,\"yPos\":1125.66675},\"ID\":31,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Ma\u0142\u0105
    i drewnian\u0105, jest ukryta tu w piwnicy, nie zd\u0105\u017Cy\u0142am po ni\u0105
    p\xF3j\u015B\u0107, bo si\u0119 wystraszy\u0142am... Ale mam do niej kluczyk
    jest w mojej lalce!\",\"parentUIDs\":[],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Ethel\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0}]}"
