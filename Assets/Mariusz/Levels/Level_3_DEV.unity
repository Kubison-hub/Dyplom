  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Na \u015Bcianie w\u015Br\xF3d fotografi i portret\xF3w ze znakomitymi
    klientami, wisi pi\u0119knie namalowany portret Madame Selmy z jej c\xF3rk\u0105.
    Ale w sumie... Co sta\u0142o si\u0119 z ojcem dziewczynki?"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: c549f2dda71f8354499e496d06e16d74, type: 2}
