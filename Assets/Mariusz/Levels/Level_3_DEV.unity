  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Wychodzi na to, \u017Ce to z tego gramofomu odtwarza si\u0119 d\u017Awi\u0119ki
    w trakcie sesji spirytualistycznych. Ale to pomieszczenie w trakcie sesji by\u0142o
    zamkni\u0119te, przynajmniej gdy jeszcze by\u0142o co\u015B wida\u0107, a jednak
    d\u017Awi\u0119i wci\u0105\u017C si\u0119 wydobywa\u0142y st\u0105d... Co oznacza,
    \u017Ce w domu musia\u0142 by\u0107 kto\u015B jeszcze, kto zarz\u0105dza\u0142
    tym urz\u0105dzeniem."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: c549f2dda71f8354499e496d06e16d74, type: 2}
  m_sharedMaterial: {fileID: 6229730292464864198, guid: c549f2dda71f8354499e496d06e16d74, type: 2}
