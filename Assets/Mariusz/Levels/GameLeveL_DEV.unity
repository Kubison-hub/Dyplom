  violetVoiceSource: {fileID: 0}
  sherlockDialogue:
    speaker: 0
    text: "Winylowe p\u0142yty, przyjrzyjmy si\u0119 im z bliska"
    voiceClip: {fileID: 8300000, guid: 5656baf4d98a9d04ab18ea45a554acb9, type: 3}
    duration: 3.252
  watsonDialogue:
    speaker: 1
    text: "Kolekcja p\u0142yt winylowych"
    voiceClip: {fileID: 8300000, guid: 7cc596eb3a3c36c498c24cda8c7bf695, type: 3}
    duration: 2.4
  watsonPickupDialogue:
    speaker: 1
    text: "\u201EDuchy przesz\u0142o\u015Bci\u201D - my\u015Bl\u0119, \u017Ce nada
      si\u0119 w sam raz"
    voiceClip: {fileID: 8300000, guid: 38b2276ac3693894eb1d80d7c768c899, type: 3}
    duration: 4
  cluePointRoot: {fileID: 0}
  cluePointDialogue:
    speaker: 0
    text: "\u201EDuchy przesz\u0142o\u015Bci\u201D \u2014 znamienne."
    voiceClip: {fileID: 8300000, guid: 13108c5342dca2044a902bae09a0a103, type: 3}
    duration: 3
