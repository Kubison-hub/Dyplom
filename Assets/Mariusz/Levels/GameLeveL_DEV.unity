--- !u!114 &556331527
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 919132149608119011}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 6847db1bc89a09246b7c92cc87b4a9c7, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  repeatable: 1
  dialogueLines: []
  sherlockVoiceSource: {fileID: 1120607583}
  watsonVoiceSource: {fileID: 8390739253207350096}
  selmaVoiceSource: {fileID: 1259649565}
  violetVoiceSource: {fileID: 0}
  firstDialogueLines:
  - speaker: 0
    text: "Sp\xF3jrz, Watsonie, jaki skomplikowany mechanizm."
    voiceClip: {fileID: 8300000, guid: e27d7581df197f94699645bbc9c4f85a, type: 3}
    duration: 3
  - speaker: 1
    text: "Rzeczywi\u015Bcie, intryguj\u0105ce."
    voiceClip: {fileID: 8300000, guid: 9c55c66e6df7daa4ca595fa20d1e21b6, type: 3}
    duration: 2.5
  - speaker: 0
    text: "Wygl\u0105da na to, \u017Ce to dzi\u0119ki niemu duchy przesz\u0142o\u015Bci
      nawiedzaj\u0105 ten dom."
    voiceClip: {fileID: 8300000, guid: 9312112f92025af4ab90e2873762573b, type: 3}
    duration: 5
  repeatDialogueLines:
  - speaker: 0
    text: "Na razie lepiej niczego tu nie rusza\u0107."
    voiceClip: {fileID: 8300000, guid: a895a1456d0b39e42b5487d9d7cda784, type: 3}
    duration: 3
