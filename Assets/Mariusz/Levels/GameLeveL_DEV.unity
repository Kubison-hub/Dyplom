    Ojcze.\",\"parentUIDs\":[75,85,89,91,103],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":90}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":958.0001,\"yPos\":429.9998},\"ID\":64,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"WYDARZENIA\",\"parentUIDs\":[75],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":86}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":601.000244,\"yPos\":349.999817},\"ID\":73,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"LADY
