  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Duchowny George uwaza\u0142, \u017Ce Lady Edith nie powinna by\u0142a
    szuka\u0107 informacji o rodzicach dla dobra imienia swojego rodu.\nWedle Duchownego
    zamiast grzeszy\u0107 wizyt\u0105 u medium, niezam\u0119\u017Cna kobieta, jak
    Lady Edith, powinna trafi\u0107 do zakomu. Pytanie brzmi, czy dla spokoju swojej
    duszy czy innych?"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: c549f2dda71f8354499e496d06e16d74, type: 2}
  m_sharedMaterial: {fileID: 6229730292464864198, guid: c549f2dda71f8354499e496d06e16d74, type: 2}
