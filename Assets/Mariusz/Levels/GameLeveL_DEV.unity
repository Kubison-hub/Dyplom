  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a000fa8bab5b0f44ba07c92bbbcac0c6, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  repeatable: 1
  dialogueLines: []
  sherlockVoiceSource: {fileID: 1120607583}
  watsonVoiceSource: {fileID: 8390739253207350096}
  selmaVoiceSource: {fileID: 0}
  violetVoiceSource: {fileID: 0}
  firstDialogueLines:
  - speaker: 0
    text: "Ma\u0142e, drewniane pude\u0142ko."
    voiceClip: {fileID: 8300000, guid: 2f5fe4f5ce8699a4c897ec339c8acb78, type: 3}
    duration: 2.48
  secondDialogueLines:
  - speaker: 0
    text: "Pude\u0142eczko jest zamkni\u0119te na ma\u0142y kluczyk. Nie b\u0119d\u0119
      niszczy\u0107 zamka wytrychem."
    voiceClip: {fileID: 8300000, guid: 8055e582c168ee3449dd8dd94a680bc3, type: 3}
    duration: 5.915
  watsonFirstDialogueLines:
  - speaker: 1
    text: "Ma\u0142a drewniana skrzynka. Ciekawe, co skrywa w \u015Brodku."
    voiceClip: {fileID: 0}
    duration: 3
  watsonSecondDialogueLines:
  - speaker: 1
    text: "Zamkni\u0119ta na ma\u0142y kluczyk. Bez niego nic tu nie wsk\xF3ramy."
    voiceClip: {fileID: 0}
    duration: 3.5
  boxVisualToHide: {fileID: 221561800}
  collidersToDisable:
  - {fileID: 221561804}
  pickupAudioSource: {fileID: 221561809}
