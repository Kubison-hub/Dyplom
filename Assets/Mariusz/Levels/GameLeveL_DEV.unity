  examinationZoneOffset: {x: 0, y: 0, z: 0}
  examinationLookAtTarget: {fileID: 114804887}
  examinationLookAtTransitionDuration: 2.1
  examinationLookAtReturnTarget: {fileID: 8698072099319906755}
  examinationLookAtReturnSpeed: 1
  showTutorialPopup: 1
  tutorialPopupDelay: 0.1
  tutorialPopupTitle: "\u015Aledztwo"
  tutorialPopupText: "Zbadaj dok\u0142adnie obiekt aby uzyska\u0107 szczeg\xF3\u0142y.\\nSherlock
    mo\u017Ce u\u017Cy\u0107 lupy <b>F</b> aby przyjrze\u0107 si\u0119 bli\u017Cej
    oraz k\xF3\u0142ka myszy aby przybli\u017Cy\u0107/oddali\u0107. "
  tutorialPopupVideoClip: {fileID: 32900000, guid: 9f4bee0b66e23c846b37b0dc6820a57f, type: 3}
  initialExaminationDialogue:
  - speaker: 0
    text: "Przyjrzyjmy si\u0119 jej uwa\u017Cnie, Watsonie."
    voiceClip: {fileID: 8300000, guid: 157f7569466cad4499f930fb6601b72e, type: 3}
    duration: 3.3
  ringCpDialogue:
  - speaker: 0
    text: "Z\u0142oty pier\u015Bcie\u0144..."
    voiceClip: {fileID: 8300000, guid: 1112628e5c583874c854b67a4ecad992, type: 3}
    duration: 1.6
  paperCpDialogue:
  - speaker: 0
    text: "Pusty pergamin w d\u0142oni ofiary..."
    voiceClip: {fileID: 8300000, guid: 7cf3f3fd37f97e74ca80e6edf29d31ac, type: 3}
    duration: 2.5
  bulletCpDialogue:
  - speaker: 0
    text: "Zdajmy si\u0119 na twoje medyczne do\u015Bwiadczenie Watsonie."
    voiceClip: {fileID: 8300000, guid: f06358f166562f948ab61a5b27ff8697, type: 3}
    duration: 3.35
  - speaker: 1
    text: "Oczywi\u015Bcie."
    voiceClip: {fileID: 8300000, guid: d63264fa3bd292741a5be0c99cdca444, type: 3}
    duration: 1.5
  arthurSmartNpc: {fileID: 90534607}
  arthurRingParameterName: Ring
  arthurPaperParameterName: Paper
  bulletCpRetryDialogue:
  - speaker: 1
    text: "Spr\xF3buj\u0119 jeszcze raz."
    voiceClip: {fileID: 8300000, guid: cc495b1b447249148aafc19d4fa7c8fd, type: 3}
    duration: 1.6
  bulletCpExamDoneDialogue:
  - speaker: 1
    text: "Kula trafi\u0142a prosto w serce i przesz\u0142a na wylot."
    voiceClip: {fileID: 8300000, guid: cc58ca6e75fa7a14f946769b1026b0b2, type: 3}
    duration: 4.25
  bulletIdeaPointToCheck: {fileID: 1531085681}
  bulletIdeaPointMissingDialogue:
  - speaker: 0
    text: W takim razie, gdzie jest kula?
    voiceClip: {fileID: 8300000, guid: edd1df7204185e946a32852982aac972, type: 3}
    duration: 2.1
  bulletCpExamIncompleteDialogue:
  - speaker: 1
    text: "Musz\u0119 dok\u0142adniej przyjrze\u0107 si\u0119 cia\u0142u."
    voiceClip: {fileID: 8300000, guid: 3c45e2c2d721563489906c10cee05dad, type: 3}
    duration: 2.88
  allCpCollectedDialogue: []
