  json: "{\"Options\":[{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":70}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-54.00084,\"yPos\":-488.0001},\"ID\":48,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Mam
    do pana kilka pyta\u0144.\",\"parentUIDs\":[0],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":83}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-71.99901,\"yPos\":156.9996},\"ID\":53,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Czy
    co\u015B \u0142\u0105czy\u0142o pana z Lady Edith?\",\"parentUIDs\":[62],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":55}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":503.9992,\"yPos\":184.666351},\"ID\":54,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Dzi\u0119kuj\u0119
    za wsp\xF3\u0142prac\u0119.\",\"parentUIDs\":[60,62,63,68,76],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":62}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-759.000549,\"yPos\":917.333557},\"ID\":61,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Dobrze\u2026
    Zmie\u0144my temat.\",\"parentUIDs\":[60],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":82}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-441.333862,\"yPos\":39.6664658},\"ID\":64,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Czy
    zauwa\u017Cy\u0142 pan co\u015B nietypowego w chwili strza\u0142u?\",\"parentUIDs\":[62],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":62}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-234.33345,\"yPos\":793.6673},\"ID\":65,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Wr\xF3\u0107my
    do innych temat\xF3w.\",\"parentUIDs\":[63],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":62}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-515.6672,\"yPos\":936.334045},\"ID\":69,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Wr\xF3\u0107my
    do innych temat\xF3w.\",\"parentUIDs\":[68],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":58}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-780.0009,\"yPos\":409.333221},\"ID\":72,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"By\u0142
    pan wcze\u015Bniej na seansach? Kadzid\u0142o to co\u015B normalnego.\",\"parentUIDs\":[80],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":60}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-824.6673,\"yPos\":701.3332},\"ID\":73,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"\u2026Wierzy
    pan w duchy?\",\"parentUIDs\":[81],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":75}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":198.9997,\"yPos\":95.9996262},\"ID\":74,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Czy
    widzia\u0142 pan, aby kto\u015B zachowywa\u0142 si\u0119 dziwnie?\",\"parentUIDs\":[62],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":62}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":151.666245,\"yPos\":807.334045},\"ID\":77,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Wr\xF3\u0107my
    do innych temat\xF3w.\",\"parentUIDs\":[76],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":49}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-752.999939,\"yPos\":-8.333595},\"ID\":78,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Co
    mo\u017Ce pan powiedzie\u0107 o dzisiejszym zdarzeniu?\",\"parentUIDs\":[62],\"SpeechUID\":-1}],\"Parameters\":[{\"__type\":\"EditableBoolParameter:#DialogueEditor\",\"ParameterName\":\"Henry\",\"BoolValue\":false},{\"__type\":\"EditableBoolParameter:#DialogueEditor\",\"ParameterName\":\"First\",\"BoolValue\":true}],\"SpeechNodes\":[{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":48}],\"EditorInfo\":{\"isRoot\":true,\"xPos\":-54.9999847,\"yPos\":-599.3332},\"ID\":0,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Panie
    Holmes? Dobrze, \u017Ce tu jeste\u015Bcie. To straszne, co si\u0119 sta\u0142o.
    Do tego moja biedna Violet\u2026 Jak mog\u0119 pom\xF3c?\",\"parentUIDs\":[],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Sir
    Henry\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0.1,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":79}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-758.0009,\"yPos\":96.6665},\"ID\":49,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"To
    wszystko wydarzy\u0142o si\u0119 tak szybko. W jednej chwili zgas\u0142y \u015Bwiat\u0142a,
    a nast\u0119pnie st\xF3\u0142 zacz\u0105\u0142 dygota\u0107\u2026 \",\"parentUIDs\":[78],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Sir
    Henry\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[],\"EditorInfo\":{\"isRoot\":false,\"xPos\":502.9992,\"yPos\":359.6661},\"ID\":55,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Je\u015Bli
    b\u0119dziemy mie\u0107 jakie\u015B pytania, wr\xF3cimy do pana.\",\"parentUIDs\":[54],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Sherlock\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":81}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-785.334045,\"yPos\":479.6666},\"ID\":58,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Tak,
    bywa\u0142em, ale tym razem ten zapach by\u0142 intensywniejszy, prawie jak w
    ko\u015Bciele. \",\"parentUIDs\":[72],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Sir
    Henry\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":61},{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":54}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-835.334167,\"yPos\":782.334045},\"ID\":60,\"ParamActions\":[{\"__type\":\"EditableSetBoolParamAction:#DialogueEditor\",\"ParameterName\":\"Henry\",\"Value\":true}],\"TMPFontGUID\":null,\"Text\":\"Niezbadane
    jest \u017Cycie po \u015Bmierci. Kto wie, czy sam ojciec nie chcia\u0142 zabra\u0107
    c\xF3rki do siebie?\",\"parentUIDs\":[73],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Sir
    Henry\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":78},{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":64},{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":74},{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":53},{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":54}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-52.9999847,\"yPos\":-288.333649},\"ID\":62,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Jak
    mog\u0119 pom\xF3c?\",\"parentUIDs\":[70,61,65,69,77],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Sir
    Henry\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":65},{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":54}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-151.333328,\"yPos\":513.332947},\"ID\":63,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Wiem,
    \u017Ce od \u015Bmierci swojego ojca by\u0142a niespokojna i potrzebowa\u0142a
    tego seansu.\",\"parentUIDs\":[83],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Sir
    Henry\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":69},{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":54}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-454.667,\"yPos\":261.333038},\"ID\":68,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"
    Mo\u017Ce krzes\u0142a, mo\u017Ce sto\u0142u?\",\"parentUIDs\":[82],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Sir
    Henry\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":62}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-52.00084,\"yPos\":-402.0002},\"ID\":70,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Oczywi\u015Bcie,
    sprawa wymaga pilnego wyja\u015Bnienia.\",\"parentUIDs\":[48],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Sir
    Henry\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":84}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":179.999573,\"yPos\":202.999359},\"ID\":75,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Tutaj?
    Nie. Wiem jedynie, \u017Ce opiekun lady Violet nie chcia\u0142 tu wchodzi\u0107,
    bo jest duchownym. \",\"parentUIDs\":[74],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Sir
    Henry\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":77},{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":54}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":166.666245,\"yPos\":569.333435},\"ID\":76,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Musia\u0142
    to zrobi\u0107 albo jej ojciec, t\u0119skni\u0105cy za c\xF3rk\u0105, albo kto\u015B
    obcy.\",\"parentUIDs\":[85],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Sir
    Henry\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":80}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-758.6668,\"yPos\":204.666473},\"ID\":79,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Powietrze
    zrobi\u0142o si\u0119 ci\u0119\u017Ckie od zapachu kadzid\u0142a, pod\u0142oga
    zacz\u0119\u0142a skrzypie\u0107\u2026 naprawd\u0119 poczu\u0142em czyj\u0105\u015B
    obecno\u015B\u0107.\",\"parentUIDs\":[49],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Sir
    Henry\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":72}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-764.6668,\"yPos\":309.333282},\"ID\":80,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"A
    potem ten straszliwy huk.\",\"parentUIDs\":[79],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Sir
    Henry\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":73}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-799.333435,\"yPos\":583.999939},\"ID\":81,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Mo\u017Ce
    to kwestia negatywnych emocji ducha? A mo\u017Ce wyj\u0105tkowo blisko mnie przeszed\u0142?\",\"parentUIDs\":[58],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Sir
    Henry\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":68}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-452.000122,\"yPos\":129.999878},\"ID\":82,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Zaraz
    przed strza\u0142em, ju\u017C po tym, jak zgas\u0142o \u015Bwiat\u0142o, us\u0142ysza\u0142em
    d\u017Awi\u0119k przesuwania czego\u015B\u2026\",\"parentUIDs\":[64],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Sir
    Henry\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":63}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-106.000076,\"yPos\":333.999969},\"ID\":83,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"To
    ciotka mojej narzeczonej. By\u0142a dla mnie surowa, ale sprawiedliwa. Szanowa\u0142em
    j\u0105. \",\"parentUIDs\":[53],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Sir
    Henry\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":85}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":174.666565,\"yPos\":315.333282},\"ID\":84,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Nie
    lubi seans\xF3w i uwa\u017Ca je za obraz\u0119 Boga.\",\"parentUIDs\":[75],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Sir
    Henry\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":76}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":170.666611,\"yPos\":435.999969},\"ID\":85,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Ale
    osobi\u015Bcie uwa\u017Cam, \u017Ce nikt z nas nie chcia\u0142by skrzywdzi\u0107
    Lady Edith. \",\"parentUIDs\":[84],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Sir
    Henry\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0}]}"
