  json: "{\"Options\":[{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":76}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-631.667053,\"yPos\":208.000031},\"ID\":48,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"G\u0142owa\",\"parentUIDs\":[0],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":55}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":443.666351,\"yPos\":274.666656},\"ID\":54,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Zako\u0144cz\",\"parentUIDs\":[0,89],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":85}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-327.66684,\"yPos\":280.000031},\"ID\":64,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Tors\",\"parentUIDs\":[0],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":89}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":170.999939,\"yPos\":277.333344},\"ID\":73,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Otoczenie
    ofiary\",\"parentUIDs\":[0],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":0}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":44.666748,\"yPos\":768.6669},\"ID\":99,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Dalej\",\"parentUIDs\":[76,85,89,104],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":103}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-80.33365,\"yPos\":279.3331},\"ID\":102,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Plecy\",\"parentUIDs\":[0],\"SpeechUID\":-1}],\"Parameters\":[{\"__type\":\"EditableBoolParameter:#DialogueEditor\",\"ParameterName\":\"BulletExamDone\",\"BoolValue\":false}],\"SpeechNodes\":[{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":48},{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":64},{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":102},{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":73},{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":54}],\"EditorInfo\":{\"isRoot\":true,\"xPos\":43,\"yPos\":22},\"ID\":0,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Co
    my tu mamy...\",\"parentUIDs\":[99],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Watson\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0.1,\"Volume\":0},{\"Connections\":[],\"EditorInfo\":{\"isRoot\":false,\"xPos\":589.332764,\"yPos\":429.6668},\"ID\":55,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Na
    razie, to wszystko.\",\"parentUIDs\":[54],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Watson\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":99}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-640.0003,\"yPos\":487.000061},\"ID\":76,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Nasza
    ofiara nie zosta\u0142a postrzelona w g\u0142ow\u0119. Nie widz\u0119 ani dziury
    wlotowej, ani tym bardziej wylotowej.\",\"parentUIDs\":[48],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Watson\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":99}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-361.000458,\"yPos\":457.666931},\"ID\":85,\"ParamActions\":[{\"__type\":\"EditableSetBoolParamAction:#DialogueEditor\",\"ParameterName\":\"BulletExamDone\",\"Value\":true}],\"TMPFontGUID\":null,\"Text\":\"Dziura
    po kuli. Strza\u0142 prosto w serce... Lady Edith odesz\u0142a nim upad\u0142a.\",\"parentUIDs\":[64],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Watson\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":99},{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":54}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":206.666534,\"yPos\":414.000061},\"ID\":89,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Na
    ofierze ani w jej pobli\u017Cu nie ma \u017Cadnych podejrzanych \u015Blad\xF3w,
    w tym prochu. Strza\u0142 na pewno nie pad\u0142 z bliska.\",\"parentUIDs\":[73],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Watson\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":104}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-80.0002747,\"yPos\":421.999817},\"ID\":103,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Ofiara
    upad\u0142a na plecy, co oznacza, \u017Ce sprawca znajdowa\u0142 si\u0119 w jakiej\u015B
    odleg\u0142o\u015Bci przed ofiar\u0105.\",\"parentUIDs\":[102],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Watson\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":99}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-76.0002747,\"yPos\":517.9998},\"ID\":104,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Do
    tego mamy tu drug\u0105 dziur\u0119, to oznacza, \u017Ce kula przesz\u0142a na
    wylot.\",\"parentUIDs\":[103],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Watson\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0}]}"
