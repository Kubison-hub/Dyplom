  hiddenDoorNotFoundDialogue:
  - speaker: 0
    text: "Musz\u0119 jeszcze odnale\u017A\u0107 ma\u0142\u0105 Ethel."
    voiceClip: {fileID: 8300000, guid: c164dee246e155d43a6cfc345288bcab, type: 3}
    duration: 2.8
  hiddenDoorFoundDialogue:
  - speaker: 0
    text: "Powinienem sprawdzi\u0107, dok\u0105d prowadzi tajne przej\u015Bcie z
