  json: "{\"Options\":[],\"Parameters\":[],\"SpeechNodes\":[{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":1}],\"EditorInfo\":{\"isRoot\":true,\"xPos\":402.666656,\"yPos\":-92.666626},\"ID\":0,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Co
    to za d\u017Awi\u0119ki? Dobiegaj\u0105 z gramofonu?\",\"parentUIDs\":[],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Violet\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":2}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":93.16666,\"yPos\":85.33339},\"ID\":1,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Trudno
    powiedzie\u0107. Nigdy wcze\u015Bniej nie s\u0142ysza\u0142em, by gramofon wydawa\u0142
    z siebie co\u015B podobnego.\",\"parentUIDs\":[0],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Watson\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":4}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":388.166626,\"yPos\":195.33342},\"ID\":2,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"By\u0107
    mo\u017Ce przemawiaj\u0105 przez niego duchy przesz\u0142o\u015Bci.\",\"parentUIDs\":[1],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Sherlock\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":5}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":90.16666,\"yPos\":338.333435},\"ID\":4,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Duchy...
    My\u015Blicie, \u017Ce pr\xF3buj\u0105 si\u0119 z nami skontaktowa\u0107?\",\"parentUIDs\":[2],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Violet\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":6}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":421.1666,\"yPos\":383.3335},\"ID\":5,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"To
    mo\u017Cliwe. By\u0107 mo\u017Ce w\u0142a\u015Bnie teraz powinni\u015Bmy poprosi\u0107
    Madame Selm\u0119 o pomoc.\",\"parentUIDs\":[4],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Watson\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":7}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":172.166672,\"yPos\":549.3332},\"ID\":6,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Je\u015Bli
    ciocia Edith pr\xF3buje co\u015B nam przekaza\u0107, musimy przeprowadzi\u0107
    kolejny seans.\",\"parentUIDs\":[5],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Violet\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":8}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":439.1667,\"yPos\":586.333069},\"ID\":7,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Porozmawiam
    z Selm\u0105 i sprowadz\u0119 j\u0105 do salonu.\",\"parentUIDs\":[6],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Watson\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[],\"EditorInfo\":{\"isRoot\":false,\"xPos\":717.166443,\"yPos\":401.333435},\"ID\":8,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"To
    twoja szansa, Holmes. Schowaj si\u0119.\",\"parentUIDs\":[7],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Watson\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0}]}"
