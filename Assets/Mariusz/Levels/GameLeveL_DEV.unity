    - target: {fileID: 222635195672935358, guid: f11b121e4a1fe0f40a2bdb489974aeb7, type: 3}
      propertyPath: json
      value: "{\"Options\":[{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":3}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":215.666687,\"yPos\":-204.999969},\"ID\":11,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Pani
        c\xF3rki na ma na pi\u0119trze, gdzie mo\u017Ce by\u0107?\",\"parentUIDs\":[1],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":5}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":67.66667,\"yPos\":25.666687},\"ID\":12,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Prosz\u0119
        si\u0119 uspokoi\u0107, rozejrz\u0119 si\u0119 za ni\u0105.\",\"parentUIDs\":[3],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":5}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":340.333344,\"yPos\":30.333374},\"ID\":13,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Musi
        mi pozwoli\u0107 Pani bada\u0107 pi\u0119tro.\",\"parentUIDs\":[3],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":7}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":199,\"yPos\":284.333374},\"ID\":14,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"A
        jak wesz\u0142a gdzie nie powinna, na przyk\u0142ad do Pani sypialni? \",\"parentUIDs\":[5],\"SpeechUID\":-1}],\"Parameters\":[],\"SpeechNodes\":[{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":1}],\"EditorInfo\":{\"isRoot\":true,\"xPos\":221.666656,\"yPos\":-421.3333},\"ID\":0,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Co
        Pan robi\u0142 na g\xF3rze!\",\"parentUIDs\":[],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Madame
        Selma\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":11}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":214.333344,\"yPos\":-329.333252},\"ID\":1,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Wszed\u0142em
        aby dok\u0142adnie zbada\u0107 miejsce zbrodni, zab\xF3jca m\xF3g\u0142 ukry\u0107
        si\u0119 na g\xF3rze\",\"parentUIDs\":[0],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Sherlock\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":12},{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":13}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":222.166656,\"yPos\":-101.666595},\"ID\":3,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Co?
        Jak to.... Panie Holmes musi j\u0105 Pan znale\u017A\u0107 b\u0142agam! Mo\u017Ce
        grozi\u0107 jej niebezpiecze\u0144stwo... moja c\xF3reczka...\",\"parentUIDs\":[11],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Madame
        Selma\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":14}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":198.166656,\"yPos\":153.000061},\"ID\":5,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Dobrze,
        ale uprzejmie prosz\u0119 nie przeszukiwa\u0107 moich rzeczy, tylko znale\u017A\u0107
        moj\u0105 c\xF3rk\u0119.\",\"parentUIDs\":[12,13],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Madame
        Selma\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":8}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":203.166656,\"yPos\":382.333466},\"ID\":7,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Na
        pewno nie. Prosz\u0119 tam nie wchodzi\u0107, to zbyt prywatna przestrze\u0144.\",\"parentUIDs\":[14],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Madame
        Selma\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[],\"EditorInfo\":{\"isRoot\":false,\"xPos\":202.166656,\"yPos\":527.0001},\"ID\":8,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Wracam
        na g\xF3r\u0119, ale prosz\u0119 pa\u0144stwo o wezwanie policji. \",\"parentUIDs\":[7],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Sherlock\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0}]}"
      objectReference: {fileID: 0}
