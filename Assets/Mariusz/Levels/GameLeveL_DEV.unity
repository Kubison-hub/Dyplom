  CurrentIDCounter: 19
  json: "{\"Options\":[{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":10}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-199.833344,\"yPos\":973.66626},\"ID\":6,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Sherlock:
    Taki mam zamiar...\",\"parentUIDs\":[4],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":8}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":318.166626,\"yPos\":814.666748},\"ID\":7,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Watson:
    Spokojnie, Madame Selmo.\",\"parentUIDs\":[4],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":12}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":41.49997,\"yPos\":1380.00012},\"ID\":11,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Zajmiemy
    si\u0119 wszystkim.\",\"parentUIDs\":[10],\"SpeechUID\":-1},{\"Connections\":[],\"EditorInfo\":{\"isRoot\":false,\"xPos\":465.666626,\"yPos\":155.6665},\"ID\":16,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"WYJD\u017B
    (DEBUG DO USUNI\u0118CIA)\",\"parentUIDs\":[],\"SpeechUID\":-1}],\"Parameters\":[],\"SpeechNodes\":[{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":1}],\"EditorInfo\":{\"isRoot\":true,\"xPos\":164.666626,\"yPos\":22},\"ID\":0,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"To
    niepoj\u0119te! Jak mog\u0142o do tego doj\u015B\u0107, i to w moim domu, na
    moim seansie?!\",\"parentUIDs\":[],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Madame
    Selma\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":2}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":168.166626,\"yPos\":180.6665},\"ID\":1,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"To
    bardzo\u2026 ciekawe.\",\"parentUIDs\":[0],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Sherlock\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":3}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":167.166626,\"yPos\":301.6665},\"ID\":2,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Co
    w tym ciekawego, panie Holmes? To tragedia.\",\"parentUIDs\":[1],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Madame
    Selma\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":4}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":169.166626,\"yPos\":486.666382},\"ID\":3,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Dobrze
    si\u0119 sk\u0142ada, \u017Ce tu jeste\u015Bmy i mo\u017Cemy zbada\u0107, <nobr>co
    zasz\u0142o<\\/nobr>, pani Selmo.\",\"parentUIDs\":[2],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Watson\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":6},{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":7}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":171.166626,\"yPos\":630.6666},\"ID\":4,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Si\u0142a
    wy\u017Csza zes\u0142a\u0142a mi pan\xF3w. Prosz\u0119 zrobi\u0107 wszystko,
    by wyja\u015Bni\u0107, co si\u0119 tutaj wydarzy\u0142o.\",\"parentUIDs\":[3],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Madame
    Selma\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":9}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":212.166626,\"yPos\":949.66626},\"ID\":8,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Jak
    mog\u0119 by\u0107 spokojna? Moja klientka w\u0142a\u015Bnie zosta\u0142a zamordowana!\",\"parentUIDs\":[7],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Madame
    Selma\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":17}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":208.833313,\"yPos\":1050},\"ID\":9,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Wiem,
    \u017Ce to przyt\u0142aczaj\u0105cy moment, ale je\u015Bli zachowa pani spok\xF3j...\",\"parentUIDs\":[8],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Watson\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":11}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":38.50003,\"yPos\":1270.99988},\"ID\":10,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Dobrze.
    Moja renoma nie mo\u017Ce przez to ucierpie\u0107. Postaram si\u0119 zachowa\u0107
    twarz mimo tych tragicznych okoliczno\u015Bci.\",\"parentUIDs\":[17,6],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Madame
    Selma\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":13}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":39.1666565,\"yPos\":1463.66675},\"ID\":12,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Wygl\u0105da
    na to, \u017Ce z zabawnego wieczoru przechodzimy do pracy, drogi Watsonie.\",\"parentUIDs\":[11],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Sherlock\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":15}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":35.1666565,\"yPos\":1579.6665},\"ID\":13,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Telegram
    nie k\u0142ama\u0142. Faktycznie kto\u015B dzisiaj zgin\u0105\u0142\u2026\",\"parentUIDs\":[12],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Watson\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[],\"EditorInfo\":{\"isRoot\":false,\"xPos\":31.1666565,\"yPos\":1738.667},\"ID\":15,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Bardzo
    ciekawe. Czas rozpocz\u0105\u0107 \u015Bledztwo.\",\"parentUIDs\":[13],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Sherlock\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":10}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":161.333374,\"yPos\":1150.3335},\"ID\":17,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Pozostali
    p\xF3jd\u0105 za pani przyk\u0142adem. Nam r\xF3wnie\u017C \u0142atwiej b\u0119dzie
    z nimi porozmawia\u0107.\",\"parentUIDs\":[9],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Watson\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0}]}"
