  violetVoiceSource: {fileID: 0}
  missingLettersDialogue:
  - speaker: 0
    text: "Nie ma sensu na razie wraca\u0107 na d\xF3\u0142"
    voiceClip: {fileID: 8300000, guid: 865324bf948d5c140903930556d922d2, type: 3}
    duration: 2.2
  hiddenDoorNotFoundDialogue:
  - speaker: 0
    text: "Musz\u0119 jeszcze odnale\u017A\u0107 ma\u0142\u0105 Ethel."
    voiceClip: {fileID: 8300000, guid: c164dee246e155d43a6cfc345288bcab, type: 3}
    duration: 2.8
  hiddenDoorFoundDialogue:
  - speaker: 0
    text: "Powinienem sprawdzi\u0107, dok\u0105d prowadzi tajne przej\u015Bcie z
      pokoju Ethel"
    voiceClip: {fileID: 8300000, guid: fa1538928b92d044e890954c3112a4bb, type: 3}
    duration: 4
  allLettersDialogue:
  - speaker: 0
    text: "Chyba mam wszystko, czego tutaj potrzebuj\u0119"
    voiceClip: {fileID: 8300000, guid: 3fe64294b7fc00845a2ab048404b6e2d, type: 3}
    duration: 3
