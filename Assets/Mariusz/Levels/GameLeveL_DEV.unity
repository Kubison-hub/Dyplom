  m_Name: 
  m_EditorClassIdentifier: 
  CurrentIDCounter: 12
  json: "{\"Options\":[],\"Parameters\":[],\"SpeechNodes\":[{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":2}],\"EditorInfo\":{\"isRoot\":true,\"xPos\":164.666626,\"yPos\":22},\"ID\":0,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Sp\xF3jrz
    Watsonie, to urz\u0105dzenie przypomina gramofon, lecz jego tuba zosta\u0142a
    po\u0142\u0105czona z mechanizmem i poprowadzona pod pod\u0142og\u0105.\",\"parentUIDs\":[],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Sherlock\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":3}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":166.666626,\"yPos\":145},\"ID\":2,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Zatem
    d\u017Awi\u0119k nie wydobywa si\u0119 wy\u0142\u0105cznie tutaj?\",\"parentUIDs\":[0],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Watson\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":8}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":166.666626,\"yPos\":275},\"ID\":3,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Urz\u0105dzenie
    musi by\u0107 po\u0142\u0105czone z gramofonem w salonie. To dzi\u0119ki niemu
    rozchodz\u0105 si\u0119 w domy ciche g\u0142osy, kt\xF3re podczas seansu brano
    za szepty duch\xF3w.\",\"parentUIDs\":[2],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Sherlock\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":9}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":13.1666412,\"yPos\":425.999939},\"ID\":8,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Sprytna
    sztuczka. Wygl\u0105da na to, \u017Ce Madame Selma mia\u0142a pomocnik\xF3w tak\u017Ce
    po drugiej stronie \u015Bciany.\",\"parentUIDs\":[3],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Watson\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":10}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":240.166626,\"yPos\":537.0001},\"ID\":9,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Lalka...
    Watsonie! Musz\u0119 dosta\u0107 si\u0119 na pi\u0119tro i odnale\u017A\u0107
    dziewczynk\u0119! Ale Selma nie odst\u0105pi od schod\xF3w.\",\"parentUIDs\":[8],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Sherlock\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":11}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":43.166626,\"yPos\":670.0001},\"ID\":10,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Rozmawia\u0142em
    z Violet. By\u0107 mo\u017Ce uda mi si\u0119 przekona\u0107 j\u0105, aby poprosi\u0142a
    Selm\u0119 o jeszcze jeden seans, tym razem pr\xF3b\u0119 nawi\u0105zania kontaktu
    z ciotk\u0105 Edith.\",\"parentUIDs\":[9],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Watson\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[],\"EditorInfo\":{\"isRoot\":false,\"xPos\":334.166626,\"yPos\":727.0001},\"ID\":11,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"To
    mog\u0142oby odci\u0105gn\u0105\u0107 j\u0105 od schod\xF3w. Najpierw jednak
    musimy uruchomi\u0107 ten mechanizm.\",\"parentUIDs\":[10],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Sherlock\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0}]}"
