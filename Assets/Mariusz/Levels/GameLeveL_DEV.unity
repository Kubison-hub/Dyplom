      propertyPath: json
      value: "{\"Options\":[{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":12}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":199.000015,\"yPos\":136.999969},\"ID\":14,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Tak,
        a czemu Pana to interesuje?\",\"parentUIDs\":[0],\"SpeechUID\":-1},{\"Connections\":[],\"EditorInfo\":{\"isRoot\":false,\"xPos\":203.000046,\"yPos\":330.999969},\"ID\":15,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Wola\u0142bym
        aby zosta\u0142 Pan z pozosta\u0142ymi.\",\"parentUIDs\":[12],\"SpeechUID\":-1}],\"Parameters\":[],\"SpeechNodes\":[{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":14}],\"EditorInfo\":{\"isRoot\":true,\"xPos\":200.333344,\"yPos\":22},\"ID\":0,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Prosz\u0119
        mi powiedzie\u0107, co z ma\u0142\u0105? Naprawd\u0119 jej nie by\u0142o?\",\"parentUIDs\":[],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Arthur\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":15}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":203.000031,\"yPos\":217.999969},\"ID\":12,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"To
        dziecko, nie chc\u0119 aby grozi\u0142o jej niebezpiecze\u0144stwo. Mog\u0119
