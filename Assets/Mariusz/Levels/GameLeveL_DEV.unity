  showTutorialPopup: 1
  tutorialPopupDelay: 0.1
  tutorialPopupTitle: "\u015Aledztwo"
  tutorialPopupText: "Zbadaj dok\u0142adnie obiekt aby uzyska\u0107 szczeg\xF3\u0142y.\\nSherlock
    mo\u017Ce u\u017Cy\u0107 lupy (F) aby przyjrze\u0107 si\u0119 bli\u017Cej oraz
    k\xF3\u0142ka myszy aby przybli\u017Cy\u0107/oddali\u0107. "
  tutorialPopupVideoClip: {fileID: 32900000, guid: b64baec8b777c7949bf50e2fedfc4fb4, type: 3}
  showNotebookTutorialPanel: 1
  notebookTutorialId: EdithExamNotebook
  notebookTutorialText: "W trakcie rozgrywki przydatne informacje zapisywane s\u0105
    w notatniku.\nWci\u015Bnij \"Tab\", aby go otworzy\u0107."
  initialExaminationDialogue:
  - speaker: 0
    text: "Przyjrzyjmy si\u0119 jej uwa\u017Cnie, Watsonie."
    voiceClip: {fileID: 8300000, guid: 157f7569466cad4499f930fb6601b72e, type: 3}
    duration: 3.3
  ringCpDialogue:
  - speaker: 0
    text: "Z\u0142oty pier\u015Bcie\u0144"
    voiceClip: {fileID: 8300000, guid: 1112628e5c583874c854b67a4ecad992, type: 3}
    duration: 1.6
  paperCpDialogue:
  - speaker: 0
    text: Niezapisana kartka papieru.
    voiceClip: {fileID: 8300000, guid: 7cf3f3fd37f97e74ca80e6edf29d31ac, type: 3}
    duration: 2.5
  bulletCpDialogue:
  - speaker: 0
    text: "Kula trafi\u0142a prosto w serce Watsonie!"
    voiceClip: {fileID: 8300000, guid: d00eafc166c49724f8c60d0592f42e7a, type: 3}
    duration: 3.2
  - speaker: 1
    text: "I przesz\u0142a na wylot, Holmes!"
    voiceClip: {fileID: 8300000, guid: 851301b13c014d445a2d9472b59dd4f4, type: 3}
    duration: 2.3
