  json: "{\"Options\":[{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":77}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":201.333344,\"yPos\":316.666748},\"ID\":48,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Nie
    przepada Ojciec za Madame Selm\u0105, prawda?\",\"parentUIDs\":[59],\"SpeechUID\":-1},{\"Connections\":[],\"EditorInfo\":{\"isRoot\":false,\"xPos\":196.000153,\"yPos\":716.3335},\"ID\":54,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Dzi\u0119kuj\u0119,
    Ojcze. Je\u015Bli pojawi\u0105 si\u0119 jeszcze pytania, wr\xF3cimy.\",\"parentUIDs\":[79],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":79}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":196.999908,\"yPos\":518.3335},\"ID\":85,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Mimo
    to pozwoli\u0142 Ojciec przyj\u015B\u0107 tutaj swojej podopiecznej.\",\"parentUIDs\":[77],\"SpeechUID\":-1}],\"Parameters\":[{\"__type\":\"EditableBoolParameter:#DialogueEditor\",\"ParameterName\":\"Selma\",\"BoolValue\":false}],\"SpeechNodes\":[{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":59}],\"EditorInfo\":{\"isRoot\":true,\"xPos\":200.333344,\"yPos\":22},\"ID\":0,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Ojcie...\",\"parentUIDs\":[],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Watson\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0.1,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":48}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":200.6666,\"yPos\":120.333344},\"ID\":59,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"M\xF3w
    mi: Ojcze George. W czym mog\u0119 pom\xF3c?\",\"parentUIDs\":[0],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Ojciec
    George\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":85}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":200.000031,\"yPos\":391.6667},\"ID\":77,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Duchy
    i magia to zabobony, a Madame Selma je szerzy. Jest artystk\u0105 sceniczn\u0105,
    kt\xF3ra wyci\u0105ga pieni\u0105dze z kieszeni bogatych.\",\"parentUIDs\":[48],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Ojciec
    George\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":54}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":193.999969,\"yPos\":603.3335},\"ID\":79,\"ParamActions\":[{\"__type\":\"EditableSetBoolParamAction:#DialogueEditor\",\"ParameterName\":\"Selma\",\"Value\":true}],\"TMPFontGUID\":null,\"Text\":\"Niestety,
    Jej Kr\xF3lewska Mo\u015B\u0107 ufa Madame Selmie. Mog\u0142em j\u0105 jedynie
    ostrzec, lecz nie mog\u0142em zabroni\u0107 jej przyj\u015Bcia.\",\"parentUIDs\":[85],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Ojciec
    George\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0}]}"
