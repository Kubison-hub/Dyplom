  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 83189876d4d389f43b7dd2e925aa112e, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  CurrentIDCounter: 85
  json: "{\"Options\":[{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":76}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":88.3334961,\"yPos\":407.3333},\"ID\":48,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"MADAME
    SELMA\",\"parentUIDs\":[75],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":55}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":718.3333,\"yPos\":376.3333},\"ID\":54,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Dzi\u0119kuj\u0119
    Ojcze, do widzenia.\",\"parentUIDs\":[75,79],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":80}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":1152.33276,\"yPos\":320.3333},\"ID\":73,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"KADZID\u0141O\",\"parentUIDs\":[],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":75}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":206.333313,\"yPos\":911.333252},\"ID\":84,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Mog\u0119
    zapyta\u0107 o co\u015B jeszcze?\",\"parentUIDs\":[79],\"SpeechUID\":-1}],\"Parameters\":[],\"SpeechNodes\":[{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":59}],\"EditorInfo\":{\"isRoot\":true,\"xPos\":697.3333,\"yPos\":29.333374},\"ID\":0,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Panie-\",\"parentUIDs\":[],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Watson\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0.1,\"Volume\":0},{\"Connections\":[],\"EditorInfo\":{\"isRoot\":false,\"xPos\":715.3333,\"yPos\":500.3333},\"ID\":55,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Je\u015Bli
    pojawi\u0105 si\u0119 jeszcze jakie\u015B pytania, wr\xF3cimy.\",\"parentUIDs\":[54],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Watson\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":75}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":684.3333,\"yPos\":131.333344},\"ID\":59,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Ojcze,
    ewentualnie Duchowny, Duchowny George. Nie jestem \u017Cadnym Panem, tylko s\u0142ug\u0105
    Pana.\",\"parentUIDs\":[0],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"George\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":48},{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":54}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":682.3333,\"yPos\":223.6667},\"ID\":75,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"S\u0142u\u017C\u0119
    odpowiedziami.\",\"parentUIDs\":[59,84],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"George\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":77}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":88.3334961,\"yPos\":481.333435},\"ID\":76,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Skoro
    jest Ojciec S\u0142ug\u0105 Bo\u017Cym, to nie przepada zapewne Ojciec za Madame
    Selm\u0105?\",\"parentUIDs\":[48],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Watson\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":78}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":83.3334961,\"yPos\":585.3333},\"ID\":77,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Duchy
    i Magia to Zabobon, a Madame Selma go krzewi. Jest artystk\u0105 sceniczn\u0105,
    kt\xF3ra wyci\u0105ga pieni\u0105dze z kiesy bogatych.\",\"parentUIDs\":[76],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"George\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":79}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":84.0002441,\"yPos\":695.3333},\"ID\":78,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Ale
    jednak pozwoli\u0142 Ojciec przyj\u015B\u0107 tutaj swojej podopiecznej, Lady
    Violet. Czy to nie jest nara\u017Canie jej?\",\"parentUIDs\":[77],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Watson\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":84},{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":54}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":82.3334961,\"yPos\":798.6666},\"ID\":79,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Poniewa\u017C,
    niestety, Jej kr\xF3lewska Mo\u015B\u0107, ufa Madame Selmie, wi\u0119c nie mam
    mocy aby odradza\u0107 przyj\u015Bcia tutaj mojej podopiecznej.\",\"parentUIDs\":[78],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"George\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":81}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":1151.33276,\"yPos\":405.3333},\"ID\":80,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Dlaczego
    pachnie Ojciec tak mocno kadzid\u0142em, skoro nie by\u0142o Ojciec tutaj od
    pocz\u0105tku? \",\"parentUIDs\":[73],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Watson\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":82}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":1149.33276,\"yPos\":521.3333},\"ID\":81,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Jestem
    w ko\u0144cu Ksi\u0119dzem, praktycznie codziennie przebywam w kaplicy. Przyja\u017Ani
    si\u0119 Pan z takim detektywem i nie umie si\u0119 Pan domy\u015Bli\u0107?\",\"parentUIDs\":[80],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"George\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":83}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":1154.33276,\"yPos\":638.3333},\"ID\":82,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Wiem,
    \u017Ce zapach na wietrze powinien zwietrze\u0107.\",\"parentUIDs\":[81],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Watson\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[],\"EditorInfo\":{\"isRoot\":false,\"xPos\":1150.99927,\"yPos\":748.9999},\"ID\":83,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Zapach
    wchodzi w ubrania po tylu latach, jest tak intensywny, ze nie da si\u0119 go
    pozby\u0107.\",\"parentUIDs\":[82],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"George\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0}]}"
