  trapDoorLookTarget: {fileID: 1135834023}
  characterTurnDuration: 0.35
  blackBoardToEnableOnTrap: {fileID: 759633756}
  blackBoardFadeMaterial: {fileID: 2100000, guid: 9c5ce036051eb5a46bc2d4ae7168e115, type: 2}
  blackBoardFadeDelay: 0.35
  blackBoardFadeDuration: 1
  blackBoardTargetAlpha: 1
  mannequinTransform: {fileID: 1891568536}
  mannequinLocalYRotation: 360
  mannequinRotationDuration: 0.8
  mannequinTrapAudioSource: {fileID: 919132147796975526}
  mannequinTrapAudioClip: {fileID: 8300000, guid: a6a882f5f05458b4888e404f0bad03b5, type: 3}
  disableAfterTrigger: 1
  trapResultDialogueLines:
  - speaker: 1
    text: "Holmes! Wyj\u015Bcie zamyka si\u0119! Jeste\u015Bmy w pu\u0142apce!"
    voiceClip: {fileID: 8300000, guid: b14c359c006fc0b418a9b7bdd9db1575, type: 3}
    duration: 4.26
  - speaker: 0
    text: "Przynajmniej odkry\u0142e\u015B mechanizm, drogi Wotsonie."
    voiceClip: {fileID: 8300000, guid: 8d24cf77b46869049a32821f674f87a1, type: 3}
    duration: 3.52
  trapDoorIdeaPoint: {fileID: 1958151628}
