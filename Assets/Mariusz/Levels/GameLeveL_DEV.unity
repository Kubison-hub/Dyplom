    mo\u017Cemy dalej?\",\"parentUIDs\":[91],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":98}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":1603.001,\"yPos\":326.999939},\"ID\":97,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"ARTHUR\",\"parentUIDs\":[],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":75}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":1380.00049,\"yPos\":1009.99957},\"ID\":104,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Te
    infomacje s\u0105 przydatne, kontynuujmy.\",\"parentUIDs\":[103],\"SpeechUID\":-1}],\"Parameters\":[],\"SpeechNodes\":[{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":59}],\"EditorInfo\":{\"isRoot\":true,\"xPos\":900,\"yPos\":-32},\"ID\":0,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Panie-\",\"parentUIDs\":[],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Sherlock\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0.1,\"Volume\":0},{\"Connections\":[],\"EditorInfo\":{\"isRoot\":false,\"xPos\":1247.66724,\"yPos\":424.999756},\"ID\":55,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Je\u015Bli
    pojawi\u0105 si\u0119 jeszcze jakie\u015B pytania, wr\xF3cimy.\",\"parentUIDs\":[54],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Sherlock\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":75}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":887,\"yPos\":70},\"ID\":59,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Ojcze,
    ewentualnie Duchowny, Duchowny George. Nie jestem \u017Cadnym Panem, tylko s\u0142ug\u0105
    Pana.\",\"parentUIDs\":[0],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"George\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":48},{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":73},{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":54},{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":64}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":885.666748,\"yPos\":163},\"ID\":75,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"S\u0142u\u017C\u0119
    odpowiedziami.\",\"parentUIDs\":[59,92,93,95,104],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"George\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":77}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":286.000244,\"yPos\":415.333069},\"ID\":76,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Co
    s\u0105dzi Ojciec na temat Lady Edith?\",\"parentUIDs\":[48],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Sherlock\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":78}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":289.000244,\"yPos\":516.999939},\"ID\":77,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Biedna...
    nie powinna wcale tutaj przychodzi\u0107. Szuka\u0142a odpowiedzi, kt\xF3rych
    nie powinna dr\u0105\u017Cy\u0107.\",\"parentUIDs\":[76],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"George\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":79}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":285.000244,\"yPos\":620.999939},\"ID\":78,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Sk\u0105d
    Ojciec zna\u0142 jej sytuacje rodzinn\u0105?\",\"parentUIDs\":[77],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Sherlock\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":80}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":286.000244,\"yPos\":727.9998},\"ID\":79,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Czy
    nie jest oczywistym, \u017Ce od Lady Violet?\",\"parentUIDs\":[78],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"George\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":81}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":284.000122,\"yPos\":833.000061},\"ID\":80,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Hm...
    Czemu zmar\u0142a nie powinna by\u0142a szuka\u0107 odpowiedzi?\",\"parentUIDs\":[79],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Sherlock\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":82}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":286.000244,\"yPos\":938.333435},\"ID\":81,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Poniewa\u017C
    mog\u0142oby to nadszarpn\u0105\u0107 dobre imie jej rodziny i zapewne nie tylko
    jej. Mia\u0142a kochaj\u0105c\u0105 rodzin\u0119, po co zna\u0107 prawd\u0119
    o grzechu z kt\xF3rego powsta\u0142a.\",\"parentUIDs\":[80],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"George\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":83}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":288.000244,\"yPos\":1049.33276},\"ID\":82,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Wida\u0107,
    \u017Ce Ojciec du\u017Co wie...\",\"parentUIDs\":[81],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Sherlock\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":84}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":290.000244,\"yPos\":1156.99951},\"ID\":83,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Prawda
    jest taka, \u017Ce niezam\u0119\u017Cna kobieta powinna p\xF3j\u015B\u0107 do
    klasztoru, a nie grzeszy\u0107.\",\"parentUIDs\":[82],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"George\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":85}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":292.000122,\"yPos\":1269.99951},\"ID\":84,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"...M\xF3wi
    pan o Lady Edith?\",\"parentUIDs\":[83],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Sherlock\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":92},{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":54}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":290.000244,\"yPos\":1377.99878},\"ID\":85,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"...a
    o kim innym?\",\"parentUIDs\":[84],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"George\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":87}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":595.000244,\"yPos\":433.9998},\"ID\":86,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Jest
    Ojciec oficjalnym opiekunem Lady Violet?\",\"parentUIDs\":[73],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Sherlock\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":88}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":594.000244,\"yPos\":546.999939},\"ID\":87,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Tak,
    z rozkazu Kr\xF3lowej czuwam nad jej bezpiecze\u0144stwem.\",\"parentUIDs\":[86],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"George\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":89}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":601.000244,\"yPos\":660.999939},\"ID\":88,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Cz\u0119sto
    przebywa\u0142a ze swoj\u0105 Ciotk\u0105, jej te\u017C ojciec pilnowa\u0142?\",\"parentUIDs\":[87],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Sherlock\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":93},{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":54}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":595.3335,\"yPos\":778.999939},\"ID\":89,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"By\u0142a
    to raczej uwa\u017Cno\u015Bc z konieczno\u015Bci, ale jestem przekonany, ze gdybym
    by\u0142 w \u015Brodku, to zapobieg\u0142bym tragedii... To wszystko przez Madame
    Selm\u0119 i jej pod\u0142e praktyki.\",\"parentUIDs\":[88],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"George\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":91}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":959.0001,\"yPos\":499.333435},\"ID\":90,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Dlaczego
    nie wszed\u0142 Ojciec do \u015Brodka?\",\"parentUIDs\":[64],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Sherlock\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":95},{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":54}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":957.0001,\"yPos\":608.999939},\"ID\":91,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Nie
    pochwalam spirytualizmu, to blu\u017Anierstwo wobec Boga. Moja noga przekroczy\u0142a
    pr\xF3g tego domu dopiero gdy us\u0142ysza\u0142em wystrza\u0142. Wiedzia\u0142em,
    \u017Ce nie sko\u0144czy si\u0119 ta wizysta niczym dobrym...ale nie s\u0105dzi\u0142em,
    ze a\u017C tak z\u0142ym.\",\"parentUIDs\":[90],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"George\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":99}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":1600.001,\"yPos\":403.999725},\"ID\":98,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Arthur
    twierdzi, \u017Ce wsp\xF3\u0142pracujecie.\",\"parentUIDs\":[97],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Sherlock\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":100}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":1601.001,\"yPos\":502.000061},\"ID\":99,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"W
    sprawach bezpiecze\u0144stwa - owszem. Obije mamy pod opiek\u0105 Damy i do tego
    spokrewnione.\",\"parentUIDs\":[98],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"George\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":101}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":1599.001,\"yPos\":596.999939},\"ID\":100,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Rozmawiali\u015Bcie
    przed Seansem?\",\"parentUIDs\":[99],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Sherlock\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":102}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":1603.001,\"yPos\":696.999939},\"ID\":101,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Tak.
    Prosi\u0142em, aby trzyma\u0142 Lady Edith z dala od tej farsy.\",\"parentUIDs\":[100],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"George\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":103}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":1605.001,\"yPos\":801.000061},\"ID\":102,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"A
    co s\u0105dzi Ojciec o Arthurze?\",\"parentUIDs\":[101],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Sherlock\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":54},{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":104}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":1604.001,\"yPos\":900.000061},\"ID\":103,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Arthur
    jest dobrym cz\u0142owiekiem, chocia\u017C emocje cz\u0119sto bior\u0105 nad
    nim g\xF3r\u0119. Serce nie zawsze podpowiada dobrze.\",\"parentUIDs\":[102],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"George\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0}]}"
