--- !u!114 &1165967196
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1165967194}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 83189876d4d389f43b7dd2e925aa112e, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  CurrentIDCounter: 22
  json: "{\"Options\":[],\"Parameters\":[],\"SpeechNodes\":[{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":11}],\"EditorInfo\":{\"isRoot\":true,\"xPos\":494.000061,\"yPos\":-504.666656},\"ID\":0,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Zaraz
    ci wszystko wyja\u015Bni\u0119 Watsonie, ale najpierw pom\xF3\u017C mi otworzy\u0107
    t\u0119 klap\u0119, kto\u015B schodz\u0105c w d\xF3\u0142 mocno j\u0105 za sob\u0105
    zatrzasn\u0105\u0142.\",\"parentUIDs\":[],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Sherlock\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":12}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":502.000183,\"yPos\":-404.666534},\"ID\":11,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Ju\u017C
    si\u0119 robi, mo\u017Ce nog\u0119 mam nie sprawn\u0105, ale krzepy mi nie brakuje.\",\"parentUIDs\":[0],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Watson\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":13}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":495.000183,\"yPos\":-281.333221},\"ID\":12,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Gotowy
    na potwory w ciemno\u015Bci?\",\"parentUIDs\":[11],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Watson\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":14}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":501.000183,\"yPos\":-164.666534},\"ID\":13,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Chyba
    na \\\"duchy\\\" przesz\u0142osci.\",\"parentUIDs\":[12],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Sherlock\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":16}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":505.000183,\"yPos\":-63.6664429},\"ID\":14,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Tutaj
    Watsonie. Zobacz, ta \u015Bciana widocznie zamocowana jest na ruchomych prowadnicach.\",\"parentUIDs\":[13],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Sherlock\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":17}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":510.000183,\"yPos\":59.3333435},\"ID\":16,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Ach
    tak?\",\"parentUIDs\":[14],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Watson\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":18}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":509.000183,\"yPos\":170.333344},\"ID\":17,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Musz\u0119
    dowiedzie\u0107 si\u0119 tylko jak otworzy\u0107 te drzwi.\",\"parentUIDs\":[16],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Sherlock\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":19}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":512.000244,\"yPos\":287.333344},\"ID\":18,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"To
    do dzie\u0142a.\",\"parentUIDs\":[17],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Watson\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":20}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":514.3336,\"yPos\":420.0002},\"ID\":19,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Niesamowite,
    jak Madame Selma przygotowa\u0142a si\u0119 na sw\xF3j biznes.\",\"parentUIDs\":[18],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Sherlock\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":21}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":518.000244,\"yPos\":539.3335},\"ID\":20,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"To
    prawda, ale Sherlocku, nie s\u0105dzisz, \u017Ce skoro Ethel mog\u0142a os\u0142ugiwa\u0107
    te mechanizmy, to oznacza, \u017Ce spotka\u0142a gdzie\u015B tutaj zab\xF3jc\u0119?\",\"parentUIDs\":[19],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Watson\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[],\"EditorInfo\":{\"isRoot\":false,\"xPos\":522.000244,\"yPos\":652.3335},\"ID\":21,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"To
    nawet pewne, dlatego powinni\u015Bmy si\u0119 pospieszy\u0107 i przeszuka\u0107
    ka\u017Cdy zakamarek. Czas na zadawanie pyta\u0107 i udzielanie odpowiedzi przyjdzie
    jak znajdziemy ma\u0142\u0105.\",\"parentUIDs\":[20],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Sherlock\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0}]}"
