    - target: {fileID: 5672837576780651852, guid: 882840d1106a78e41b59570597aa5f4c, type: 3}
      propertyPath: connections.Array.data[2].dependencyMode
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 5672837576780651852, guid: 882840d1106a78e41b59570597aa5f4c, type: 3}
      propertyPath: connections.Array.data[3].dependencyMode
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 5672837576780651852, guid: 882840d1106a78e41b59570597aa5f4c, type: 3}
      propertyPath: connections.Array.data[4].dependencyMode
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 5672837576780651852, guid: 882840d1106a78e41b59570597aa5f4c, type: 3}
      propertyPath: connections.Array.data[0].firstDescription
      value: "\u201ETrajektoria z okna omija st\xF3\u0142. Mebel mo\u017Ce by\u0107
        podejrzany, lecz tym razem ma alibi geometryczne.\u201D"
      objectReference: {fileID: 0}
    - target: {fileID: 5672837576780651852, guid: 882840d1106a78e41b59570597aa5f4c, type: 3}
      propertyPath: connections.Array.data[1].firstDescription
      value: "\u201ELinia poprowadzona od uszkodzenia w oknie wraca prosto ku podejrzanej
        \u015Bcianie. Mur w\u0142a\u015Bnie straci\u0142 prawo do milczenia.\u201D"
      objectReference: {fileID: 0}
    - target: {fileID: 5672837576780651852, guid: 882840d1106a78e41b59570597aa5f4c, type: 3}
      propertyPath: connections.Array.data[2].firstDescription
      value: "\u201EKominek o\u015Bwietla\u0142 drog\u0119 spojrzeniu, ale pocisk
        wybra\u0142 w\u0142asn\u0105 drog\u0119 ku szybie. Obie przecinaj\u0105 salon.\u201D"
      objectReference: {fileID: 0}
    - target: {fileID: 5672837576780651852, guid: 882840d1106a78e41b59570597aa5f4c, type: 3}
      propertyPath: connections.Array.data[3].firstDescription
      value: "\u201EKula utkwi\u0142a w oknie, pozwalaj\u0105c odczyta\u0107 trajektori\u0119
        lotu a\u017C do Lady Edith. Pociski s\u0105 brutalne, lecz konsekwentne.\u201D"
      objectReference: {fileID: 0}
    - target: {fileID: 5672837576780651852, guid: 882840d1106a78e41b59570597aa5f4c, type: 3}
      propertyPath: connections.Array.data[4].firstDescription
      value: "\u201EZgaszone \u015Bwiat\u0142o ukry\u0142o strzelca przed lud\u017Ami,
        ale nie przed geometri\u0105. Okno nadal wskazuje kierunek.\u201D"
      objectReference: {fileID: 0}
    - target: {fileID: 5672837576780651852, guid: 882840d1106a78e41b59570597aa5f4c, type: 3}
      propertyPath: connections.Array.data[0].canConnectReverse
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 5672837576780651852, guid: 882840d1106a78e41b59570597aa5f4c, type: 3}
      propertyPath: connections.Array.data[0].lockedDescription
      value: "Brakuje mi jeszcze jednego faktu. Dedukcja, podobnie jak herbata, \u0179le
        znosi po\u015Bpiech."
      objectReference: {fileID: 0}
    - target: {fileID: 5672837576780651852, guid: 882840d1106a78e41b59570597aa5f4c, type: 3}
      propertyPath: connections.Array.data[0].repeatDescription
      value: "\u201EMechanizm jest wa\u017Cny, ale nie le\u017Cy na torze pocisku.\u201D"
      objectReference: {fileID: 0}
    - target: {fileID: 5672837576780651852, guid: 882840d1106a78e41b59570597aa5f4c, type: 3}
      propertyPath: connections.Array.data[1].canConnectReverse
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 5672837576780651852, guid: 882840d1106a78e41b59570597aa5f4c, type: 3}
      propertyPath: connections.Array.data[1].lockedDescription
      value: "Brakuje mi jeszcze jednego faktu. Dedukcja, podobnie jak herbata, \u0179le
        znosi po\u015Bpiech."
      objectReference: {fileID: 0}
    - target: {fileID: 5672837576780651852, guid: 882840d1106a78e41b59570597aa5f4c, type: 3}
      propertyPath: connections.Array.data[1].repeatDescription
      value: "\u201EOkno wskazuje miejsce, z kt\xF3rego musia\u0142 pa\u015B\u0107
        strza\u0142.\u201D"
      objectReference: {fileID: 0}
    - target: {fileID: 5672837576780651852, guid: 882840d1106a78e41b59570597aa5f4c, type: 3}
      propertyPath: connections.Array.data[2].canConnectReverse
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 5672837576780651852, guid: 882840d1106a78e41b59570597aa5f4c, type: 3}
      propertyPath: connections.Array.data[2].lockedDescription
      value: "Brakuje mi jeszcze jednego faktu. Dedukcja, podobnie jak herbata, \u0179le
        znosi po\u015Bpiech."
      objectReference: {fileID: 0}
    - target: {fileID: 5672837576780651852, guid: 882840d1106a78e41b59570597aa5f4c, type: 3}
      propertyPath: connections.Array.data[2].repeatDescription
      value: "\u201E\u015Awiat\u0142o pomaga\u0142o celowa\u0107; okno pokazuje rezultat.\u201D"
      objectReference: {fileID: 0}
    - target: {fileID: 5672837576780651852, guid: 882840d1106a78e41b59570597aa5f4c, type: 3}
      propertyPath: connections.Array.data[3].canConnectReverse
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 5672837576780651852, guid: 882840d1106a78e41b59570597aa5f4c, type: 3}
      propertyPath: connections.Array.data[3].lockedDescription
      value: "Brakuje mi jeszcze jednego faktu. Dedukcja, podobnie jak herbata, \u0179le
        znosi po\u015Bpiech."
      objectReference: {fileID: 0}
    - target: {fileID: 5672837576780651852, guid: 882840d1106a78e41b59570597aa5f4c, type: 3}
      propertyPath: connections.Array.data[3].repeatDescription
      value: "\u201E\u015Alad w szybie i pozycja Lady Edith tworz\u0105 jedn\u0105
