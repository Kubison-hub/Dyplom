  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Lady Edith zgin\u0119\u0142a od strza\u0142u w g\u0142ow\u0119. Kula utk\u0119\u0142a
    w czaszce, wi\u0119c bro\u0144 by\u0142a albo s\u0142aba, albo znajdowa\u0142a
    si\u0119 daleko. Brak prochu przy stole sugeruje, \u017Ce strza\u0142 nie pad\u0142
    z bliska. Strzelec musia\u0142 by\u0107 do\u015Bwiadczony, gdy\u017C zdo\u0142a\u0142
    dokona\u0107 tego w mroku,wiedz\u0105c gdzie siedzi Lady Edith. Niestety ofiara
    zieni\u0142a po\u0142o\u017Cenie, wi\u0119c nie wiadomo sk\u0105d dok\u0142adnie
    pad\u0142 strza\u0142."
