  firstPassageDialogueLines:
  - speaker: 0
    text: "Kolejna podejrzana \u015Bciana, wygl\u0105da na to, \u017Ce ten dom skrywa
      znacznie wi\u0119cej tajemnic."
    voiceClip: {fileID: 8300000, guid: fd43cc3a8b7d00a45b07e0c4837364ea, type: 3}
    duration: 9.56
  repeatedPassageDialogueLines:
  - speaker: 0
    text: "T\u0119dy nie przejd\u0119,"
    voiceClip: {fileID: 8300000, guid: 4d75f2a73a9cb504bb12026e5e48497f, type: 3}
    duration: 2
  gramophoneController: {fileID: 0}
  afterGramophoneDialogueLines:
  - speaker: 0
    text: "T\u0119dy nie przejd\u0119. Musz\u0119 poszuka\u0107 ma\u0142ej Ethel
      na pi\u0119trze."
    voiceClip: {fileID: 8300000, guid: e300be977d7ea224eb63179439ca926b, type: 3}
    duration: 5
  stairsUp: {fileID: 95926125}
