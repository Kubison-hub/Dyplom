  m_EditorClassIdentifier: 
  CurrentIDCounter: 53
  json: "{\"Options\":[{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":26}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":410.266754,\"yPos\":-237.399887},\"ID\":23,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Chcia\u0142bym
    z\u0142o\u017Cy\u0107 panience wyrazy wsp\xF3\u0142czucia.\",\"parentUIDs\":[0],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":45}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":143.333344,\"yPos\":343.999939},\"ID\":43,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Po
    dzisiejszym wieczorze trudno to wykluczy\u0107.\",\"parentUIDs\":[42],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":49}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":602.333252,\"yPos\":339},\"ID\":48,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Jestem
    lekarzem, panienko Violet.\",\"parentUIDs\":[42],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":51}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":365.333344,\"yPos\":618.9998},\"ID\":50,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Prosz\u0119
    na siebie uwa\u017Ca\u0107, panienko Violet.\",\"parentUIDs\":[45,49],\"SpeechUID\":-1}],\"Parameters\":[],\"SpeechNodes\":[{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":23}],\"EditorInfo\":{\"isRoot\":true,\"xPos\":409.3334,\"yPos\":-346},\"ID\":0,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"O
    co chodzi, doktorze?\",\"parentUIDs\":[],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Violet\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":27}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":407.400421,\"yPos\":-164.466629},\"ID\":26,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"\u015Amier\u0107
    kogo\u015B bliskiego mo\u017Ce wydawa\u0107 si\u0119 ko\u0144cem \u015Bwiata\u2026\",\"parentUIDs\":[23],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Watson\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":41}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":406.866669,\"yPos\":-73.59996},\"ID\":27,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Dla
    mnie to jest koniec \u015Bwiata, panie Watson.\",\"parentUIDs\":[26],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Violet\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":52}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":409.333282,\"yPos\":25.0000763},\"ID\":41,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Prosz\u0119
    mi wierzy\u0107. Z do\u015Bwiadczenia wiem, \u017Ce gdy przejdziemy przez \u017Ca\u0142ob\u0119,
    \u015Bwiat z czasem zn\xF3w nabiera barw.\",\"parentUIDs\":[27],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Watson\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":43},{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":48}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":410.9999,\"yPos\":248.000015},\"ID\":42,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Chcia\u0142abym
    m\xF3c porozmawia\u0107 z ni\u0105 cho\u0107 ten ostatni raz\u2026 Czy my\u015Bli
    pan, \u017Ce jest to mo\u017Cliwe?\",\"parentUIDs\":[52],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Violet\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":50}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":190.333313,\"yPos\":481.999939},\"ID\":45,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Mo\u017Ce
    wi\u0119c istnieje jeszcze spos\xF3b\u2026\",\"parentUIDs\":[43],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Violet\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":50}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":534.3334,\"yPos\":490.999939},\"ID\":49,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Rozumiem\u2026
    By\u0107 mo\u017Ce powinnam porozmawia\u0107 z Madame Selm\u0105.\",\"parentUIDs\":[48],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Violet\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[],\"EditorInfo\":{\"isRoot\":false,\"xPos\":361.333344,\"yPos\":758.999939},\"ID\":51,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Dzi\u0119kuj\u0119
    za s\u0142owa wsparcia, panie Watson.\",\"parentUIDs\":[50],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Violet\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":42}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":405.000031,\"yPos\":139.999985},\"ID\":52,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Najtrudniejsze
    bywaj\u0105 s\u0142owa, kt\xF3rych nie zd\u0105\u017Cyli\u015Bmy wypowiedzie\u0107.\",\"parentUIDs\":[41],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Watson\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0}]}"
