  repeatable: 1
  dialogueLines:
  - speaker: 0
    text: "Potrzebuj\u0119 Watsona\n"
    voiceClip: {fileID: 0}
    duration: 2
  sherlockVoiceSource: {fileID: 1120607583}
  watsonVoiceSource: {fileID: 1120607583}
  selmaVoiceSource: {fileID: 1259649565}
  violetVoiceSource: {fileID: 7472971700428621913}
  hatchLid: {fileID: 1149073613}
  openEulerX: -2.709
  openSpeed: 70
  hatchAudioSource: {fileID: 1067507037}
  hatchOpenAudio: {fileID: 8300000, guid: 76338e72705d5fe4cb13ab39cf5eba6a, type: 3}
  hatchOpenFx: []
  watsonAnimator: {fileID: 5183965932948898846}
  watsonOpenHatchTrigger: OpenHatch
  watsonOpenHatchDelay: 1
  sherlockFirstDialogue:
  - speaker: 0
    text: "Klapa jest zbyt ci\u0119\u017Cka, potrzebuj\u0119 Watsona."
    voiceClip: {fileID: 8300000, guid: 16bb7a9f022af9c41aae1dbc9c3fc440, type: 3}
    duration: 5.53
  sherlockRepeatDialogue:
  - speaker: 0
    text: "Potrzebuj\u0119 Watsona"
    voiceClip: {fileID: 8300000, guid: 735de71e9e83bd4419c08965a6994694, type: 3}
    duration: 1.5
  watsonInRoomDialogue:
  - speaker: 0
    text: "To drzwi do ostatniego rozdzia\u0142u tej zagadki..."
    voiceClip: {fileID: 8300000, guid: 8e6aeb107b1ec5549b48cc69bbfffa97, type: 3}
    duration: 4
  - speaker: 1
    text: "Nie mog\u0119 si\u0119 doczeka\u0107, Sherlock."
    voiceClip: {fileID: 8300000, guid: 305e0561ca629d64cbb63b577ecad44a, type: 3}
    duration: 2.25
  watsonOpenDialogue:
  - speaker: 0
    text: 
    voiceClip: {fileID: 0}
    duration: 2
  - speaker: 1
    text: "Droga wolna Holmes, ciemno\u015B\u0107 wzywa, przyjacielu."
    voiceClip: {fileID: 8300000, guid: 3b1063daf97273342aa4e817fe10d488, type: 3}
    duration: 4.2
  - speaker: 0
    text: "I duchy przesz\u0142o\u015Bci..."
    voiceClip: {fileID: 8300000, guid: 46d68c07effa38a40b5572476b45026a, type: 3}
    duration: 2
  isWatsonInRoom: 0
  watsonReactionTurnSpeed: 180
