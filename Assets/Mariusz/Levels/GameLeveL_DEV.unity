      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 5672837576780651852, guid: 882840d1106a78e41b59570597aa5f4c, type: 3}
      propertyPath: connections.Array.data[0].firstDescription
      value: "\u201EDwa zegary milcz\u0105 razem. Jeden zatrzyma\u0142 wspomnienie,
        drugi strze\u017Ce mechanizmu.\u201D"
      objectReference: {fileID: 0}
    - target: {fileID: 5672837576780651852, guid: 882840d1106a78e41b59570597aa5f4c, type: 3}
      propertyPath: connections.Array.data[1].firstDescription
      value: "\u201E\u015Awiat\u0142o kominka pada\u0142o ku \u015Bcianie, pozostawiaj\u0105c
        osob\u0119 ukryt\u0105 przy niej niemal niewidoczn\u0105.\u201D"
      objectReference: {fileID: 0}
    - target: {fileID: 5672837576780651852, guid: 882840d1106a78e41b59570597aa5f4c, type: 3}
      propertyPath: connections.Array.data[2].firstDescription
      value: "\u201E\u015Awiat\u0142o kominka by\u0142o jedynym \u015Bwiat\u0142em
        w pomieszczeniu. Lady Edith pozostawa\u0142a widoczna, napastnik niekoniecznie.\u201D"
      objectReference: {fileID: 0}
    - target: {fileID: 5672837576780651852, guid: 882840d1106a78e41b59570597aa5f4c, type: 3}
      propertyPath: connections.Array.data[3].firstDescription
      value: "\u201EOgie\u0144 m\xF3g\u0142 odbi\u0107 si\u0119 w szybie, ale nie
        wybi\u0142 w niej tej dziury. Kominki maj\u0105 temperament, nie bro\u0144
        paln\u0105.\u201D"
      objectReference: {fileID: 0}
    - target: {fileID: 5672837576780651852, guid: 882840d1106a78e41b59570597aa5f4c, type: 3}
      propertyPath: connections.Array.data[4].firstDescription
      value: "\u201E\u015Awiat\u0142o kominka by\u0142o jedynym \u015Bwiat\u0142em
        w pomieszczeniu. Skromny awans dla paleniska, znakomita os\u0142ona dla mordercy.\u201D"
      objectReference: {fileID: 0}
    - target: {fileID: 5672837576780651852, guid: 882840d1106a78e41b59570597aa5f4c, type: 3}
      propertyPath: connections.Array.data[0].canConnectReverse
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 5672837576780651852, guid: 882840d1106a78e41b59570597aa5f4c, type: 3}
      propertyPath: connections.Array.data[0].lockedDescription
      value: "Brakuje mi jeszcze jednego faktu. Dedukcja, podobnie jak herbata, \u0179le
        znosi po\u015Bpiech."
      objectReference: {fileID: 0}
    - target: {fileID: 5672837576780651852, guid: 882840d1106a78e41b59570597aa5f4c, type: 3}
      propertyPath: connections.Array.data[0].repeatDescription
      value: "\u201EDwa zegary milcz\u0105 razem. Jeden zatrzyma\u0142 wspomnienie,
        drugi strze\u017Ce mechanizmu.\u201D"
      objectReference: {fileID: 0}
    - target: {fileID: 5672837576780651852, guid: 882840d1106a78e41b59570597aa5f4c, type: 3}
      propertyPath: connections.Array.data[1].canConnectReverse
