MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1531085674}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d6e05c7e55b33584a9357053959aa1f3, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  ideaId: IdeaPoint_Window
  ideaTitle: Uszkodzone okno
  ideaDescription: "Kula wyznacza trajektor\u0119 strza\u0142u."
  ideaDescriptionDelay: 0.2
  discoveryMode: 2
  connections:
  - target: {fileID: 1117572484}
    canConnect: 0
    canConnectReverse: 1
    firstTitle: Sherlock Holmes
    firstDescription: "\u201ETrajektoria z okna omija st\xF3\u0142.\""
    repeatTitle: Sherlock Holmes
    repeatDescription: "\u201EMechanizm jest wa\u017Cny, ale nie le\u017Cy na torze
      pocisku.\u201D"
    dependencyMode: 0
    requiredConnections: []
    lockedTitle: Jeszcze nie.
    lockedDescription: "Brakuje mi jeszcze jednego faktu. Dedukcja, podobnie jak
      herbata, \u0179le znosi po\u015Bpiech."
  - target: {fileID: 832249382}
    canConnect: 1
    canConnectReverse: 1
    firstTitle: Sherlock Holmes
    firstDescription: "\u201ELinia poprowadzona od uszkodzenia w oknie wraca prosto
      ku podejrzanej \u015Bcianie. Mur w\u0142a\u015Bnie straci\u0142 prawo do milczenia.\u201D"
    repeatTitle: Sherlock Holmes
    repeatDescription: "\u201EOkno wskazuje miejsce, z kt\xF3rego musia\u0142 pa\u015B\u0107
      strza\u0142.\u201D"
    dependencyMode: 0
    requiredConnections: []
    lockedTitle: Jeszcze nie.
    lockedDescription: "Brakuje mi jeszcze jednego faktu. Dedukcja, podobnie jak
      herbata, \u0179le znosi po\u015Bpiech."
  - target: {fileID: 1899288024}
    canConnect: 0
    canConnectReverse: 1
    firstTitle: Sherlock Holmes
    firstDescription: "\u201EKominek o\u015Bwietla\u0142 drog\u0119 spojrzeniu, ale
      pocisk wybra\u0142 w\u0142asn\u0105 drog\u0119 ku szybie. Obie przecinaj\u0105
      salon.\u201D"
    repeatTitle: Sherlock Holmes
    repeatDescription: "\u201E\u015Awiat\u0142o pomaga\u0142o celowa\u0107; okno
      pokazuje rezultat.\u201D"
    dependencyMode: 0
    requiredConnections: []
    lockedTitle: Jeszcze nie.
    lockedDescription: "Brakuje mi jeszcze jednego faktu. Dedukcja, podobnie jak
      herbata, \u0179le znosi po\u015Bpiech."
  - target: {fileID: 96440272}
    canConnect: 1
    canConnectReverse: 1
    firstTitle: Sherlock Holmes
    firstDescription: "\u201EKula utkwi\u0142a w oknie, pozwalaj\u0105c odczyta\u0107
      trajektori\u0119 lotu a\u017C do Lady Edith. Pociski s\u0105 brutalne, lecz
      konsekwentne.\u201D"
    repeatTitle: Sherlock Holmes
    repeatDescription: "\u201E\u015Alad w szybie i pozycja Lady Edith tworz\u0105
      jedn\u0105 lini\u0119.\u201D"
    dependencyMode: 0
    requiredConnections: []
    lockedTitle: Jeszcze nie.
    lockedDescription: "Brakuje mi jeszcze jednego faktu. Dedukcja, podobnie jak
      herbata, \u0179le znosi po\u015Bpiech."
  - target: {fileID: 0}
    canConnect: 0
    canConnectReverse: 1
    firstTitle: Sherlock Holmes
    firstDescription: "\u201EZgaszone \u015Bwiat\u0142o ukry\u0142o strzelca przed
      lud\u017Ami, ale nie przed geometri\u0105. Okno nadal wskazuje kierunek.\u201D"
    repeatTitle: Sherlock Holmes
    repeatDescription: "\u201EMrok oszuka\u0142 \u015Bwiadk\xF3w, nie trajektori\u0119
      pocisku.\u201D"
    dependencyMode: 0
    requiredConnections: []
    lockedTitle: Jeszcze nie.
    lockedDescription: "Brakuje mi jeszcze jednego faktu. Dedukcja, podobnie jak
      herbata, \u0179le znosi po\u015Bpiech."
