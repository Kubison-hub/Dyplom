--- !u!114 &483830807
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 483830805}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 83189876d4d389f43b7dd2e925aa112e, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  CurrentIDCounter: 32
  json: "{\"Options\":[],\"Parameters\":[],\"SpeechNodes\":[{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":22}],\"EditorInfo\":{\"isRoot\":true,\"xPos\":492.6667,\"yPos\":-157.333374},\"ID\":0,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"K-kim
    jeste\u015B! Aaa, pomocy!\",\"parentUIDs\":[],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Ethel\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":23}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":495.6667,\"yPos\":-53.333313},\"ID\":22,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Spokojnie,
    pami\u0119tasz nas z g\xF3ry? Byli\u015Bmy na seansie.\",\"parentUIDs\":[0],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Sherlock,
    Watson\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":24}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":496.6667,\"yPos\":58.666687},\"ID\":23,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Czy
    z moj\u0105 mam\u0105 wszystko w porz\u0105dku? Us\u0142ysza\u0142am strza\u0142,
    a chwil\u0119 wcze\u015Bniej min\u0119\u0142am si\u0119 w podziemiach z jakim\u015B
    wielkim Panem. Wystraszy\u0142am si\u0119 i przybieg\u0142am tutaj...\",\"parentUIDs\":[22],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Ethel\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":25}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":497.6667,\"yPos\":172.666748},\"ID\":24,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Tak
    Ethel, z woj\u0105 mam\u0105 wszystko jest dobrze...\",\"parentUIDs\":[23],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Watson\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":26}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":501.000061,\"yPos\":281.666748},\"ID\":25,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"A...
    a z tat\u0105? Nie powinnam pyta\u0107 ale boj\u0119 si\u0119...\",\"parentUIDs\":[24],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Ethel\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":27}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":503.6667,\"yPos\":389.666748},\"ID\":26,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Tat\u0105?\",\"parentUIDs\":[25],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Sherlock,
    Watson\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":28}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":500.6667,\"yPos\":503.666748},\"ID\":27,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Nie
    powinnam tego m\xF3wi\u0107, bo podobno m\xF3j tata to taki dzisiejszy rycerz
    i m\xF3wi\u0142 mi, \u017Ce si\u0119 ukrywa. By\u0142 dzisiaj na seansie z dam\u0105
    kt\xF3r\u0105 chroni, tak\u0105 starsz\u0105 pani\u0105. Czy wszystko z nim dobrze?\",\"parentUIDs\":[26],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Ethel\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":29}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":501.6667,\"yPos\":618.6669},\"ID\":28,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Tak,
    jak najbardziej.\",\"parentUIDs\":[27],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Sherlock,
    Watson\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":30}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":498.6667,\"yPos\":729.0006},\"ID\":29,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Jak
    dobrze... mama m\xF3wi\u0142a, \u017Ce jak b\u0119dzie dzia\u0142o si\u0119 co\u015B
    z\u0142ego to mam schowac si\u0119 tutaj, a potem i\u015B\u0107 do Pa\u0142acu,
    je\u015Bli si\u0119 da to z Lady Violet i... i przekaza\u0107 skrzyneczk\u0119
    Kr\xF3lowej.\",\"parentUIDs\":[28],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Ethel\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":31}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":497.6667,\"yPos\":849.6669},\"ID\":30,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Jak\u0105
    skrzyneczk\u0119?\",\"parentUIDs\":[29],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Sherlock,
    Watson\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[],\"EditorInfo\":{\"isRoot\":false,\"xPos\":504.6667,\"yPos\":971.667},\"ID\":31,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"T\u0119.
    Nie mam klucza, bo jest schowany, ale mama m\xF3wi\u0142a, \u017Ce Lady Violet
    wie gdzie jest i w razie czego mog\u0119 j\u0105 poprosi\u0107, Ale mama lubi
    zagadki i Lady Violet nawet nie wie do czego ten kluczyk!\",\"parentUIDs\":[30],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Ethel\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0}]}"
