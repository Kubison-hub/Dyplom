      objectReference: {fileID: 0}
    - target: {fileID: 1838028954207984806, guid: c4c349b242619764aa1b4817aeb0163a, type: 3}
      propertyPath: m_text
      value: "Lady Edith nie \u017Cyje. Zosta\u0142a zamordowana podczas spirytystycznego
        seansu w domu medium, madame Selmy. Gdy zgas\u0142y \u015Bwiat\u0142a, tajemniczy
        sprawca wy\u0142oni\u0142 si\u0119 z ciemno\u015Bci niczym zjawa, odda\u0142
        \u015Bmiertelny strza\u0142 i znikn\u0105\u0142, zanim ktokolwiek zdo\u0142a\u0142
        go dostrzec. Musimy ustali\u0107, kto poci\u0105gn\u0105\u0142 za spust i
        dlaczego dokona\u0142 tak straszliwego morderstwa."
      objectReference: {fileID: 0}
