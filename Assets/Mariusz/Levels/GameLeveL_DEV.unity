    - target: {fileID: 5672837576780651852, guid: 882840d1106a78e41b59570597aa5f4c, type: 3}
      propertyPath: connections.Array.data[0].dependencyMode
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 5672837576780651852, guid: 882840d1106a78e41b59570597aa5f4c, type: 3}
      propertyPath: connections.Array.data[1].dependencyMode
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 5672837576780651852, guid: 882840d1106a78e41b59570597aa5f4c, type: 3}
      propertyPath: connections.Array.data[2].dependencyMode
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 5672837576780651852, guid: 882840d1106a78e41b59570597aa5f4c, type: 3}
      propertyPath: connections.Array.data[3].dependencyMode
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 5672837576780651852, guid: 882840d1106a78e41b59570597aa5f4c, type: 3}
      propertyPath: connections.Array.data[4].dependencyMode
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 5672837576780651852, guid: 882840d1106a78e41b59570597aa5f4c, type: 3}
      propertyPath: connections.Array.data[0].firstDescription
      value: "\u201EWy\u0142\u0105czone \u015Bwiat\u0142o pozostawi\u0142o kominek
        jedynym \u017Ar\xF3d\u0142em blasku. Kto\u015B zadba\u0142 o mrok, lecz nie
        o ca\u0142kowit\u0105 ciemno\u015B\u0107.\u201D"
      objectReference: {fileID: 0}
    - target: {fileID: 5672837576780651852, guid: 882840d1106a78e41b59570597aa5f4c, type: 3}
      propertyPath: connections.Array.data[1].firstDescription
      value: "\u201EPo zgaszeniu lamp ruchomy st\xF3\u0142 znika\u0142 w p\xF3\u0142mroku.
        Mechanizm mo\u017Cna by\u0142o uruchomi\u0107 bez zwracania uwagi go\u015Bci.\u201D"
      objectReference: {fileID: 0}
    - target: {fileID: 5672837576780651852, guid: 882840d1106a78e41b59570597aa5f4c, type: 3}
      propertyPath: connections.Array.data[2].firstDescription
      value: "\u201EZgaszone lampy pogr\u0105\u017Cy\u0142y t\u0119 \u015Bcian\u0119
        w cieniu. Idealne miejsce, by przej\u015Bcie otworzy\u0142o si\u0119 bez
        zaproszenia.\u201D"
      objectReference: {fileID: 0}
    - target: {fileID: 5672837576780651852, guid: 882840d1106a78e41b59570597aa5f4c, type: 3}
      propertyPath: connections.Array.data[3].firstDescription
      value: "\u201EKiedy Lady Edith upada\u0142a, \u015Bwiat\u0142o w\u0142a\u015Bnie
        przesta\u0142o dzia\u0142a\u0107. Przypadek ma czasem wyczucie dramaturgii,
        lecz rzadko a\u017C tak dobre.\u201D"
      objectReference: {fileID: 0}
    - target: {fileID: 5672837576780651852, guid: 882840d1106a78e41b59570597aa5f4c, type: 3}
      propertyPath: connections.Array.data[4].firstDescription
      value: "\u201EBrak \u015Bwiat\u0142a nie uszkodzi\u0142 okna, ale utrudni\u0142
        \u015Bwiadkom dostrze\u017Cenie kierunku strza\u0142u. Szyba zapami\u0119ta\u0142a
        go za nich.\u201D"
      objectReference: {fileID: 0}
    - target: {fileID: 5672837576780651852, guid: 882840d1106a78e41b59570597aa5f4c, type: 3}
      propertyPath: connections.Array.data[0].canConnectReverse
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 5672837576780651852, guid: 882840d1106a78e41b59570597aa5f4c, type: 3}
      propertyPath: connections.Array.data[0].lockedDescription
      value: "Brakuje mi jeszcze jednego faktu. Dedukcja, podobnie jak herbata, \u0179le
        znosi po\u015Bpiech."
      objectReference: {fileID: 0}
    - target: {fileID: 5672837576780651852, guid: 882840d1106a78e41b59570597aa5f4c, type: 3}
      propertyPath: connections.Array.data[0].repeatDescription
