    go z naszym manekinem.\",\"parentUIDs\":[199],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Sherlock\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":182},{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":184}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":2233,\"yPos\":-421},\"ID\":202,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Ach
