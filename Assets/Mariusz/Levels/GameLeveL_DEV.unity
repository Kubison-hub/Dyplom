      objectReference: {fileID: 0}
    - target: {fileID: 5672837576780651852, guid: 882840d1106a78e41b59570597aa5f4c, type: 3}
      propertyPath: connections.Array.data[2].repeatDescription
      value: "\u201EW ciemnym salonie ogie\u0144 wskazywa\u0142 cel a\u017C nazbyt
        uprzejmie.\u201D"
      objectReference: {fileID: 0}
    - target: {fileID: 5672837576780651852, guid: 882840d1106a78e41b59570597aa5f4c, type: 3}
