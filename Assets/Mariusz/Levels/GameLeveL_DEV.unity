    du\u017Co istotnych poszlak na pi\u0119trze.\",\"parentUIDs\":[1],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":15}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-26.8333435,\"yPos\":-611.000854},\"ID\":13,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Nie
