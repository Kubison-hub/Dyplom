  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Arthur jest przej\u0119ty faktem, \u017Ce nie uda\u0142o mu si\u0119 ochoroni\u0107
    ofiary. \nGdy dosz\u0142o do strza\u0142u nie by\u0142o go przy stole, gdy\u017C
    twierdzi, \u017Ce powodem jest l\u0119k przed ciemno\u015Bci\u0105."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: c549f2dda71f8354499e496d06e16d74, type: 2}
