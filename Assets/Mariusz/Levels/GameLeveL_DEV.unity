--- !u!114 &919132147796975522
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 919132147796975521}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 70e39a847e5bf324e92b73c8d60883b5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  repeatable: 1
  dialogueLines:
  - speaker: 0
    text: "Ciekawa Posta\u0107. Wygl\u0105da do\u015B\u0107 przea\u017Caj\u0105co."
    voiceClip: {fileID: 8300000, guid: e27505e4a7571cd45aa35ec26cd4c096, type: 3}
    duration: 4.69
  - speaker: 1
    text: "Dobrze to uj\u0105\u0142e\u015B, Sherlock."
    voiceClip: {fileID: 8300000, guid: bb0b120652638de449e3df16e42ef723, type: 3}
    duration: 2
  - speaker: 0
    text: "Co\u015B mi podpowiada, \u017Ce w \u015Brodku kryje si\u0119 jaki\u015B
      mechanizm."
    voiceClip: {fileID: 8300000, guid: 247002d859a393746a47f8e5e813032d, type: 3}
    duration: 5.34
  sherlockVoiceSource: {fileID: 1120607583}
  watsonVoiceSource: {fileID: 8390739253207350096}
  selmaVoiceSource: {fileID: 0}
  violetVoiceSource: {fileID: 0}
  secondInteractionDialogueLines:
  - speaker: 0
    text: "Co\u015B mi podpowiada, \u017Ce w \u015Brodku kryje si\u0119 jaki\u015B
      mechanizm."
    voiceClip: {fileID: 8300000, guid: 247002d859a393746a47f8e5e813032d, type: 3}
    duration: 5.34
  mannequinIdeaPoint: {fileID: 1545613876}
  secretDoorAnimators:
  - {fileID: 1135834027}
  secretDoorCloseTrigger: Close
  setOpenedBoolOnDoors: 0
  openedBool: Opened
  secretDoorAudioSources:
  - {fileID: 1135834034}
