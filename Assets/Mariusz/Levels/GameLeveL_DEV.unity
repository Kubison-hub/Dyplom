  json: "{\"Options\":[{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":49}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":560,\"yPos\":337.999969},\"ID\":48,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"POCZUCE
    WINY\",\"parentUIDs\":[59],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":55}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":920.3336,\"yPos\":321.999969},\"ID\":54,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Dzi\u0119kuj\u0119
    za rozmow\u0119...\",\"parentUIDs\":[58,59,81],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":59}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":252.000061,\"yPos\":1593.99951},\"ID\":72,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Rozumiem...\",\"parentUIDs\":[81],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":58}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":139.000183,\"yPos\":317.999969},\"ID\":73,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Kim
    Pan jest?\",\"parentUIDs\":[59],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":59}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":133.000183,\"yPos\":532.0001},\"ID\":74,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Mi\u0142o
    pozna\u0107.\",\"parentUIDs\":[58],\"SpeechUID\":-1}],\"Parameters\":[],\"SpeechNodes\":[{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":59}],\"EditorInfo\":{\"isRoot\":true,\"xPos\":504,\"yPos\":6.00003052},\"ID\":0,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Witam
    Panowie...\",\"parentUIDs\":[],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Watson\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0.1,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":50}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":562,\"yPos\":455.0001},\"ID\":49,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Musi
    Panu by\u0107 ci\u0119\u017Cko z tym co si\u0119 sta\u0142o.\",\"parentUIDs\":[48],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Watson\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":60}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":564.9999,\"yPos\":586.000244},\"ID\":50,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Ja...
    Mia\u0142em j\u0105 chroni\u0107. Nie mia\u0142em nawet jak w tej sytuacji. Czuj\u0119
    tak\u0105 przemo\u017Cn\u0105 bezsilno\u015B\u0107... Lady Edith na mnie polega\u0142a.
    To moja wina... powinienem by\u0142 j\u0105 os\u0142oni\u0107.\",\"parentUIDs\":[49],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Arthur\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[],\"EditorInfo\":{\"isRoot\":false,\"xPos\":927.0001,\"yPos\":418.0001},\"ID\":55,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Zapewne
    do Pana jeszcze wr\xF3cimy...\",\"parentUIDs\":[54],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Sherlock\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":74},{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":54}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":139.000183,\"yPos\":390.999969},\"ID\":58,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Nazywam
    sie Arthur i jestem... By\u0142em ochroniarzem Lady Edith.\",\"parentUIDs\":[73],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Arthur\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":48},{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":54},{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":73}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":510,\"yPos\":142},\"ID\":59,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Zrobi\u0119
    wszytsko by pom\xF3c.\",\"parentUIDs\":[0,72,74],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Arthur\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":61}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":559.666748,\"yPos\":699.3336},\"ID\":60,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Siedzia\u0142
    pan obok niej, nie mia\u0142 Pan jak temu zapobiedz.\",\"parentUIDs\":[50],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Watson\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":75}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":563.9999,\"yPos\":808.0002},\"ID\":61,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Wiem,
    \u017Ce by\u0142em za daleko...\",\"parentUIDs\":[60],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Arthur\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":76}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":562.3334,\"yPos\":917.0002},\"ID\":75,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"To
    gdzie Pan by\u0142, kiedy zgas\u0142o \u015Bwiat\u0142o?\",\"parentUIDs\":[61],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Watson\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":77}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":566.9999,\"yPos\":1032.99951},\"ID\":76,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"...Wsta\u0142em
    od sto\u0142u.\",\"parentUIDs\":[75],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Arthur\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":78}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":565.9999,\"yPos\":1139.99976},\"ID\":77,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"W
    jakim celu?\",\"parentUIDs\":[76],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Watson\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":79}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":561.6666,\"yPos\":1247.33374},\"ID\":78,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Chcia\u0142em,
    podej\u015B\u0107 do okna. Zrobi\u0142o mi si\u0119 duszno.\",\"parentUIDs\":[77],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Arthur\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":81}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":562.9999,\"yPos\":1356},\"ID\":79,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Boi
    si\u0119 pan ciemno\u015Bci?\",\"parentUIDs\":[78],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Watson\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":72},{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":54}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":560,\"yPos\":1463.00024},\"ID\":81,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"*spi\u0119ty*
    Mo\u017Cna tak powiedzie\u0107... wiem, \u017Ce wygl\u0105da to kiepsko, ale
    przysi\u0119gam, \u017Ce nic jej nie zrobi\u0142em...\",\"parentUIDs\":[79],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Arthur\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0}]}"
