  m_Script: {fileID: 11500000, guid: 6847db1bc89a09246b7c92cc87b4a9c7, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  repeatable: 1
  dialogueLines: []
  sherlockVoiceSource: {fileID: 0}
  watsonVoiceSource: {fileID: 0}
  selmaVoiceSource: {fileID: 0}
  violetVoiceSource: {fileID: 0}
  firstDialogueLines:
  - speaker: 0
    text: "Sp\xF3jrz, Watsonie, jaki skomplikowany mechanizm."
    voiceClip: {fileID: 0}
    duration: 3
  - speaker: 1
    text: "Rzeczywi\u015Bcie, intryguj\u0105ce."
    voiceClip: {fileID: 0}
    duration: 2.5
  - speaker: 0
    text: "Wygl\u0105da na to, \u017Ce to dzi\u0119ki niemu duchy przesz\u0142o\u015Bci
      nawiedzaj\u0105 ten dom."
    voiceClip: {fileID: 0}
    duration: 4
  repeatDialogueLines:
  - speaker: 0
    text: "Na razie lepiej niczego tu nie rusza\u0107."
    voiceClip: {fileID: 0}
    duration: 3
