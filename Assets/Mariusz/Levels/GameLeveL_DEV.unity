MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1277166580}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: adc96b1267fda2248ac7ae3267ceb31d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  startsSwitchTutorial: 1
  representsWatson: 1
  sherlockPlayerIndex: 0
  watsonPlayerIndex: 1
  questionMarkToHide: {fileID: 1797786413}
  deactivateOnTutorialComplete: {fileID: 1277166580}
  tutorialCollider: {fileID: 0}
  watsonEscortNpcToActivate: {fileID: 146037421}
  watsonTurnSpeed: 200
  watsonTurnStartProgress: 0.5
  sherlockApproachDistance: 1.5
  sherlockApproachNavMeshSampleRadius: 1.2
  openingDialogueLines:
  - speaker: 0
    text: 
    voiceClip: {fileID: 0}
    duration: 0.2
  - speaker: 0
    text: "Chcia\u0142bym aby\u015B porozmawia\u0142 z biedn\u0105 pann\u0105 Violet,
      Watsonie... "
    voiceClip: {fileID: 8300000, guid: 91f6ea2be4bf21740b1f6e49ba784579, type: 3}
    duration: 4
  - speaker: 1
    text: "Oczywi\u015Bcie Sherlock. Jestem do us\u0142ug."
    voiceClip: {fileID: 8300000, guid: f3a2001e30ceb7c4ab232679754fd517, type: 3}
    duration: 4.2
  - speaker: 0
    text: "Przede wszystkim... Wyprowad\u017A j\u0105 na chwil\u0119 z biblioteki..."
    voiceClip: {fileID: 8300000, guid: 3760a9ab87289a2408d97e89d03f9897, type: 3}
    duration: 4.25
  tutorialPanelId: WatsonSwitchTutorial
  tutorialText: "W grze mo\u017Cesz sterowa\u0107 tak\u017Ce Watsonem,\\naby zdobywa\u0107
    wi\u0119cej informacji przes\u0142uchuj\u0105c \u015Bwiadk\xF3w oraz przemieszcza\u0107
    niekt\xF3re obiekty.\\nJe\u017Celi Watson jest w pobli\u017Cu - wci\u015Bnij
    <b>Spacj\u0119</b>, aby prze\u0142\u0105cza\u0107 si\u0119 pomi\u0119dzy postaciami."
  afterPopupDialogueLines:
  - speaker: 0
    text: Powodzenia.
    voiceClip: {fileID: 8300000, guid: eecfbce7f7e045e4481793dddf1bb1e0, type: 3}
    duration: 1.1
  sherlockVoiceSource: {fileID: 1120607583}
  watsonVoiceSource: {fileID: 8390739253207350096}
  afterSwitchTutorialTitle: Watson
  afterSwitchTutorialText: "Watson mo\u017Ce rozmawia\u0107 ze \u015Bwiadkami,\\naby
    odwr\xF3ci\u0107 uwag\u0119 od Sherlocka.\\nPrzytrzymaj <b>Lewy Shift</b> i kliknij
    w posta\u0107, aby j\u0105 zaprosi\u0107 na pogaw\u0119dk\u0119 lub kr\xF3tki
    spacer."
  afterSwitchTutorialVideoClip: {fileID: 32900000, guid: b48ab7525f7debf46a93ef20d34de9a5, type: 3}
  watsonRepeatText: Sherlock?
  sherlockRepeatText: Watson?
