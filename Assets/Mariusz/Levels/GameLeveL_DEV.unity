  m_Name: 
  m_EditorClassIdentifier: 
  CurrentIDCounter: 67
  json: "{\"Options\":[{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":49}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":193.999969,\"yPos\":253.000061},\"ID\":48,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"WYDARZENIA\",\"parentUIDs\":[58],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":56}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":1151,\"yPos\":264.000061},\"ID\":53,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"ZAR\u0118CZYNY\",\"parentUIDs\":[58],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":55}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":788,\"yPos\":261.000061},\"ID\":54,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Dzi\u0119kuj\u0119
    za wsp\xF3\u0142prac\u0119\",\"parentUIDs\":[49,57,58,62],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":60}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":495.999878,\"yPos\":405},\"ID\":59,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"INNI\",\"parentUIDs\":[58],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":58}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":196.999969,\"yPos\":435.000183},\"ID\":63,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Rozwi\u0144my
    inne tematy\",\"parentUIDs\":[49],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":58}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":271.999969,\"yPos\":793.0001},\"ID\":65,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Jeszcze
    chcia\u0142bym o co\u015B zapyta\u0107.\",\"parentUIDs\":[62],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":58}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":1079.99976,\"yPos\":570},\"ID\":66,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Pozwoli
    Pan, \u017Ce zadam kolejne pytanie?\",\"parentUIDs\":[57],\"SpeechUID\":-1}],\"Parameters\":[],\"SpeechNodes\":[{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":58}],\"EditorInfo\":{\"isRoot\":true,\"xPos\":811.3334,\"yPos\":10},\"ID\":0,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Pan
    Watson...?\\nDobrze, \u017Ce tu jeste\u015Bcie, to straszne co to si\u0119 sta\u0142o.
    Do tego moja biedna Violet....\",\"parentUIDs\":[],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Sir
    Henry\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0.1,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":63},{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":54}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":195.999969,\"yPos\":318.000061},\"ID\":49,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"To
    wszystko wydarzy\u0142o si\u0119 tak szybko. W jednej chwili zgas\u0142y swiat\u0142a,
    a nast\u0119pnie st\xF3\u0142 zacz\u0105l dygota\u0107\u2026 \",\"parentUIDs\":[48],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Sir
    Henry\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[],\"EditorInfo\":{\"isRoot\":false,\"xPos\":778,\"yPos\":648.3334},\"ID\":55,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Je\u015Bli
    b\u0119dziemy mie\u0107 jakie\u015B pytania, wr\xF3cimy do Pana.\",\"parentUIDs\":[54],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Watson\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":57}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":1152,\"yPos\":327.000061},\"ID\":56,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Czy
    Lady Edith akceptowa\u0142a zar\u0119czyny Pana z Lady Violet?\",\"parentUIDs\":[53],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Watson\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":66},{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":54}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":1154,\"yPos\":434.333435},\"ID\":57,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Oczywi\u015Bcie,
    ale w\u0142asnie dlatego mia\u0142a mnie na oku. Ja z Violet \u017Cyli\u015Bmy
    na dworze kr\xF3lewskim na codzie\u0144, a ona bardzo cz\u0119sto nas odwiedza\u0142a.
    Sam cz\u0119sto zasi\u0119ga\u0142em rad Madame Selmy aby jej nie podpa\u015B\u0107.\",\"parentUIDs\":[56],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Sir
    Henry\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":48},{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":53},{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":54},{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":59}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":811,\"yPos\":110.999985},\"ID\":58,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Jak
    mog\u0119 pom\xF3c?\",\"parentUIDs\":[0,63,65,66],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Sir
    Henry\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":61}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":494.666565,\"yPos\":510.999878},\"ID\":60,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Czy
    widzia\u0142 Pan aby kto\u015B z obecnych zachowywa\u0142 si\u0119 dziwnie?\",\"parentUIDs\":[59],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Watson\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":62}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":497.999939,\"yPos\":629},\"ID\":61,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Tutaj?
    Nie. Wiem jedynie, \u017Ce opiekun mojej Lady Violet nie chcia\u0142 tu wchodzi\u0107,
    bo jest to duchowny. Nie lubi seans\xF3w i uwa\u017Ca to za obraz\u0119 Boga.\",\"parentUIDs\":[60],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Sir
    Henry\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":65},{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":54}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":494.999878,\"yPos\":766.000061},\"ID\":62,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Ale
    osobi\u015Bcie uwa\u017Cam, \u017Ce nikt z nas nie chcia\u0142by skrzywdzi\u0107
    Lady Edith. Musia\u0142 to zrobi\u0107 albo jej ojciec t\u0119skni\u0105cy na
    c\xF3rk\u0105, albo ktos obcy.\",\"parentUIDs\":[61],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Sir
    Henry\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0}]}"
