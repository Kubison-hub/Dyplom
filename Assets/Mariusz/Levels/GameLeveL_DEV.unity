  CurrentIDCounter: 91
  json: "{\"Options\":[{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":90}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":830.999939,\"yPos\":-690.9998},\"ID\":48,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Musi
    panu by\u0107 ci\u0119\u017Cko po tym, co si\u0119 sta\u0142o.\",\"parentUIDs\":[0],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":55}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":848.666443,\"yPos\":560.3332},\"ID\":72,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Rozumiem...\",\"parentUIDs\":[81],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":76}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":837.3331,\"yPos\":-149.333435},\"ID\":87,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Gdzie
    by\u0142 pan, kiedy zgas\u0142o \u015Bwiat\u0142o?\",\"parentUIDs\":[61],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":78}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":845.666443,\"yPos\":95.33362},\"ID\":88,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"W
    jakim celu?\",\"parentUIDs\":[76],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":81}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":847.9998,\"yPos\":340.666565},\"ID\":89,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Boi
    si\u0119 pan ciemno\u015Bci?\",\"parentUIDs\":[78],\"SpeechUID\":-1}],\"Parameters\":[],\"SpeechNodes\":[{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":48}],\"EditorInfo\":{\"isRoot\":true,\"xPos\":833,\"yPos\":-796.6667},\"ID\":0,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"O
    co chodzi, panie Watsonie?\",\"parentUIDs\":[],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Arthur\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0.1,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":60}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":836.666565,\"yPos\":-516.6663},\"ID\":50,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Lady
    Edith na mnie polega\u0142a. To moja wina. Powinienem by\u0142 j\u0105 os\u0142oni\u0107.\",\"parentUIDs\":[90],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Arthur\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[],\"EditorInfo\":{\"isRoot\":false,\"xPos\":846.3329,\"yPos\":634.0003},\"ID\":55,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Zapewne
    jeszcze do pana wr\xF3cimy.\",\"parentUIDs\":[72],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Watson\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":61}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":836,\"yPos\":-407.6664},\"ID\":60,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Siedzia\u0142
    pan niedaleko niej i widzia\u0142 niewiele, jak ka\u017Cdy z nas. Nie mia\u0142
    pan jak temu zapobiec.\",\"parentUIDs\":[50],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Watson\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":87}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":835,\"yPos\":-279.666382},\"ID\":61,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Wiem,
    \u017Ce po prostu by\u0142em za daleko...\",\"parentUIDs\":[60],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Arthur\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":88}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":841.333252,\"yPos\":-44.0003662},\"ID\":76,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"...Wsta\u0142em
    od sto\u0142u.\",\"parentUIDs\":[87],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Arthur\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":89}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":842.6666,\"yPos\":211.0003},\"ID\":78,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Chcia\u0142em
    podej\u015B\u0107 do okna. Zrobi\u0142o mi si\u0119 duszno.\",\"parentUIDs\":[88],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Arthur\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":72}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":845.6667,\"yPos\":446.999817},\"ID\":81,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Mo\u017Cna
    tak powiedzie\u0107... Jestem \u015Bwiadomy, \u017Ce wygl\u0105da to kiepsko,
    ale przysi\u0119gam, \u017Ce nie ja jestem temu winny.\",\"parentUIDs\":[89],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Arthur\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":50}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":829.3333,\"yPos\":-625.3333},\"ID\":90,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Ja...
    mia\u0142em j\u0105 chroni\u0107. W tej sytuacji nie mia\u0142em nawet jak. Czuj\u0119
    tak\u0105 przemo\u017Cn\u0105 bezsilno\u015B\u0107... \",\"parentUIDs\":[48],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Arthur\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0}]}"
