  m_Script: {fileID: 11500000, guid: 8ebbf5064190e4340af5d5b2b99c1ef0, type: 3}
  m_Name: "\u015Arodowisko Row 33"
  m_EditorClassIdentifier: 
  noteTitle: List od A
  category: 2
  content: "Ukochana,\n\nWiedz\u0105c, \u017Ce tw\xF3j pierwotny plan nie wyszed\u0142,
    przypominam ci w\u0105tek Lady Etith. B\u0119dzie sk\u0142onna du\u017Co zap\u0142aci\u0107
    za informacje. Dobrze zrobi\u0142a\u015B pal\u0105c dowody i tworz\u0105c sobie
    zabezpieczenie. Wiem, \u017Ce na ten moment nie s\u0105 w stanie tobie zagrozi\u0107.
    Lady Ogilvy b\u0119dzie szcz\u0119\u015Bliwa dowiaduj\u0105c si\u0119 prawdy,
    a my wzbogacimy si\u0119 na czas tej politycznej blokady na Dworze.\nDo zobaczenia,\n\nA."
  customPaperGraphic: {fileID: 0}
