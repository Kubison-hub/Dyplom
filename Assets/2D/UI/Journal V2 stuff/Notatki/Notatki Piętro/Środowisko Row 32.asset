  m_Script: {fileID: 11500000, guid: 8ebbf5064190e4340af5d5b2b99c1ef0, type: 3}
  m_Name: "\u015Arodowisko Row 32"
  m_EditorClassIdentifier: 
  noteTitle: Notatki na toaletce
  category: 2
  person: 0
  observation: 0
  content: "Klientka od A. \u2013 Edith Isabel Ogilvy (ur. 1836) \u2013 niezam\u0119\u017Cna
    i bogata kobieta. Na \u0142o\u017Cu \u015Bmierci ojca dowiedzia\u0142a si\u0119,
    \u017Ce zosta\u0142a adoptowana. Wysokie wynagrodzenie.\r\n\r\nBratanica \u2013
    Violet Olivia Juliana Ogilvy (ur. 1862) \u2013 ulubienica ciotki, przydatne \u017Ar\xF3d\u0142o
    informacji.\r\n\r\nMatka \u2013 Frances Margaret Howard? (ur. 1817, status nieznany)
    \u2013 c\xF3rka hrabiego Suffolk, by\u0142a dw\xF3rka kr\xF3lowej Wiktorii, spokrewniona
    z adopcyjnymi rodzicami lady Edith. Wiadomo, \u017Ce po urodzeniu nie\u015Blubnego
    dziecka zosta\u0142a odes\u0142ana do klasztoru. Brak pewno\u015Bci, czy Edith
    jest owym dzieckiem.\r\n\r\nPrzybrany ojciec \u2013 sir John Ogilvy, 9. baronet
    (ur. 1803, zm. 1890).\r\n\r\nPrzybrana matka \u2013 Jane Elizabeth Ogilvy z d.
    Howard (1809\u20131861) \u2013 starsza siostra Frances Margaret Howard.\r\n\r\nOjciec...
    [tre\u015B\u0107 wypalona]\r\n\r\nKonieczne uruchomienie kontakt\xF3w."
  customPaperGraphic: {fileID: 0}
