  m_Script: {fileID: 11500000, guid: 8ebbf5064190e4340af5d5b2b99c1ef0, type: 3}
  m_Name: "\u015Arodowisko Row 26"
  m_EditorClassIdentifier: 
  noteTitle: Nadpalony list w kominku
  category: 2
  person: 0
  observation: 0
  content: "Szanowna Madame Selmo,\r\n\r\nPani oferta bezpiecznego przechowywania
    informacji o... zostaje definitywnie odrzucona. Uprzejmie radzimy Pani, dla dobra
    w\u0142asnego i rodziny, przesta\u0107 sk\u0142ada\u0107 takie oferty zar\xF3wno
    nam, jak i udost\u0119pnia\u0107 rzekom\u0105 wiedz\u0119 innym kontrahentom,
    a zw\u0142aszcza... Jak na kobiet\u0119 o takim statusie i renomie na dworze,
    Pani zachowanie jest nieprzyzwoite i mo\u017Ce przynie\u015B\u0107 op\u0142akane
    skutki dla Pani... Prosz\u0119 pami\u0119ta\u0107, \u017Ce wypadki i nieszcz\u0119\u015Bcia
    chodz\u0105 po ludziach..."
  customPaperGraphic: {fileID: 0}
