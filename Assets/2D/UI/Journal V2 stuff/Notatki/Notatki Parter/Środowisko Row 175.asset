  m_Script: {fileID: 11500000, guid: 8ebbf5064190e4340af5d5b2b99c1ef0, type: 3}
  m_Name: "\u015Arodowisko Row 175"
  m_EditorClassIdentifier: 
  noteTitle: Gramofon 1
  category: 2
  content: "Wychodzi na to, \u017Ce to z tego gramofonu odtwarza si\u0119 d\u017Awieki
    w trakcie sesji spirytualistycznych. Ale to pomieszczenie w trakcie sesji by\u0142o
    zamkni\u0119te, przynajmniej gdy jeszcze by\u0142o co\u015B wida\u0107, a jednak
    d\u017Awi\u0119k wci\u0105\u017C si\u0119 wydobywa\u0142y st\u0105d... Co oznacza,
    \u017Ce w domu musia\u0142 by\u0107 kto\u015B jeszcze, kto zarz\u0105dza\u0142
    tym urz\u0105dzeniem."
  customPaperGraphic: {fileID: 0}
