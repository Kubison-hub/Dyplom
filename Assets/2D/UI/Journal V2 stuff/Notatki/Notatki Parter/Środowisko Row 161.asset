  m_Script: {fileID: 11500000, guid: 8ebbf5064190e4340af5d5b2b99c1ef0, type: 3}
  m_Name: "\u015Arodowisko Row 161"
  m_EditorClassIdentifier: 
  noteTitle: Dom
  category: 2
  content: "Kamienica znajduje si\u0119 w bogatej dzielnicy, a jej wn\u0119trza \u015Bwiadcz\u0105
    o maj\u0105tku w\u0142a\u015Bcicielki. Madame Selma, nie jest szlanchiank\u0105,
    ale zdecydowanie wie jak prowadzic sw\xF3j biznes. Taka du\u017Ca posiad\u0142o\u015B\u0107
    musi skrywa\u0107 wiele sekret\xF3w."
  customPaperGraphic: {fileID: 0}
