      m_Calls: []
  m_text: "Lady Edith nie \u017Cyje. Zosta\u0142a zamordowana na naszych oczach podczas
    spirytystycznego seansu w domu medium, madame Selmy. Gdy zgas\u0142y \u015Bwiat\u0142a,
    napastnik przemkn\u0105\u0142 przez salon niczym zjawa i znikn\u0105\u0142 w
    ciemno\u015Bci. Musimy ustali\u0107, kto poci\u0105gn\u0105\u0142 za spust i
    dlaczego dokona\u0142 tej zbrodni."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: c549f2dda71f8354499e496d06e16d74, type: 2}
