  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Henry \u017Cyje z Violet na Dworze Kr\xF3lewskim, Ciotka odwiedzia\u0142a
    ich, maj\u0105c na oku przed \u015Blubem. Violet by\u0142a dla niej jak c\xF3rka,
    wi\u0119c dla Henrego by\u0142a bardzo wymagaj\u0105ca (Po w\u0105tku Zar\u0119czyny)\nSir
    Henry tak\u017Ce zasi\u0119ga\u0142 rad u Madame Selmy."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: c549f2dda71f8354499e496d06e16d74, type: 2}
